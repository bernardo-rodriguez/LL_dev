{% comment %}
  Final step: report card with 3 selling points that appear one at a time while a
  spinner sits above them on the white card (see .quiz__final-loading-overlay in quiz.liquid).
  When the sequence finishes, the overlay hides and the email field is shown below the report.
{% endcomment %}
<div class="quiz-final-step" data-quiz-final-step>
  <div class="quiz-report-card" data-quiz-report-card>
    <p class="quiz-report-card__title h5">Your personalized snapshot</p>
    <ul class="quiz-report-card__list list-unstyled" role="list">
      <li class="quiz-report-card__item" data-quiz-report-item>
        Whitening strength tuned to your sensitivity — so you can brighten comfortably, not painfully.
      </li>
      <li class="quiz-report-card__item" data-quiz-report-item>
        A formula direction matched to your goals and habits — fewer compromises, clearer expectations.
      </li>
      <li class="quiz-report-card__item" data-quiz-report-item>
        Professional-grade care you can stick with — built around how you brush, eat, and whiten today.
      </li>
    </ul>
  </div>

  <div class="quiz-loading-email" data-quiz-loading-email>
    <label class="h5" for="ourformbutforklaviyo">Enter your email to unlock your results</label>
    <div class="quiz__input-group">
      <input
        class="for_email_klaviyo"
        type="email"
        name="contact[email]"
        style="color: #3a5ca5"
        id="ourformbutforklaviyo"
        placeholder="Email"
        required
      >
      <input class="for_email_klaviyo" type="hidden" name="contact[tags]" value="newsletter">
      <p class="form-error-message body-xs hidden">This field is required</p>
    </div>
  </div>
</div>

<script>
  (function() {
    var stepWrapper = document.querySelector('.form__step-wrapper[data-step="6"]');
    var card = document.querySelector('.quiz__content-card');
    var overlay = document.querySelector('[data-quiz-final-overlay]');
    var fillEl = document.querySelector('[data-quiz-final-spinner-fill]');
    var items = document.querySelectorAll('[data-quiz-report-item]');
    var emailWrap = document.querySelector('[data-quiz-loading-email]');
    var submitBtn = document.querySelector('[data-form-submit]');
    if (!stepWrapper || !overlay || !fillEl || items.length === 0) return;

    var STAGGER_MS = 1500;
    var PAD_AFTER_LAST_MS = 700;

    var CIRCUMFERENCE = 2 * Math.PI * 20;
    var loadStart = 0;
    var rafId = null;
    var timers = [];
    var totalDurationMs = STAGGER_MS * items.length + PAD_AFTER_LAST_MS;

    function setSubmitDisabled(disabled) {
      if (!submitBtn) return;
      if (disabled) {
        submitBtn.setAttribute('disabled', 'true');
        submitBtn.setAttribute('aria-disabled', 'true');
      } else {
        submitBtn.removeAttribute('disabled');
        submitBtn.removeAttribute('aria-disabled');
      }
    }

    function showOverlay() {
      overlay.classList.add('is-visible');
      overlay.setAttribute('aria-hidden', 'false');
    }

    function hideOverlay() {
      overlay.classList.remove('is-visible');
      overlay.setAttribute('aria-hidden', 'true');
    }

    function resetItems() {
      items.forEach(function(li) {
        li.classList.remove('quiz-report-card__item--visible');
      });
    }

    function tickProgress() {
      var elapsed = performance.now() - loadStart;
      var p = Math.max(0, Math.min(1, elapsed / totalDurationMs));
      fillEl.style.strokeDashoffset = CIRCUMFERENCE * (1 - p);
      if (p < 1) {
        rafId = requestAnimationFrame(tickProgress);
      }
    }

    function clearTimers() {
      timers.forEach(function(t) { clearTimeout(t); });
      timers = [];
      if (rafId) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
    }

    function revealEmail() {
      if (emailWrap) {
        emailWrap.classList.add('quiz-loading-email--visible');
      }
      hideOverlay();
      setSubmitDisabled(false);
      try {
        var quizEl = stepWrapper.closest('formula-quiz');
        if (quizEl && quizEl.setInputs) {
          quizEl.setInputs('6');
        }
      } catch (e) { /* no-op */ }
    }

    function startSequence() {
      clearTimers();
      resetItems();
      showOverlay();
      setSubmitDisabled(true);

      if (emailWrap) {
        emailWrap.classList.remove('quiz-loading-email--visible');
      }

      fillEl.style.strokeDasharray = CIRCUMFERENCE + ' ' + CIRCUMFERENCE;
      fillEl.style.strokeDashoffset = CIRCUMFERENCE;
      loadStart = performance.now();
      rafId = requestAnimationFrame(tickProgress);

      items.forEach(function(li, i) {
        timers.push(setTimeout(function() {
          li.classList.add('quiz-report-card__item--visible');
        }, STAGGER_MS * i));
      });

      timers.push(setTimeout(revealEmail, totalDurationMs));
    }

    function stopSequence() {
      clearTimers();
      hideOverlay();
      fillEl.style.strokeDashoffset = CIRCUMFERENCE;
    }

    fillEl.style.strokeDasharray = CIRCUMFERENCE + ' ' + CIRCUMFERENCE;
    fillEl.style.strokeDashoffset = CIRCUMFERENCE;

    if (stepWrapper.classList.contains('active')) {
      startSequence();
    }

    var observer = new MutationObserver(function(mutations) {
      mutations.forEach(function(mut) {
        if (mut.attributeName === 'class') {
          if (stepWrapper.classList.contains('active')) {
            startSequence();
          } else {
            stopSequence();
            if (emailWrap) {
              emailWrap.classList.remove('quiz-loading-email--visible');
            }
            setSubmitDisabled(false);
          }
        }
      });
    });
    observer.observe(stepWrapper, { attributes: true, attributeFilter: ['class'] });
  })();
</script>

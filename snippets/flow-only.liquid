{%- comment -%}
  Emits the attribute that limits a section to one flow. Drop it into the
  section's own tag:

    <section class="..." {% render 'flow-only', visibility: section.settings.flow_visibility %}>

  'all' (or blank) emits nothing, so a section that has never been configured
  behaves exactly as it did before. See snippets/flow-detect.liquid.
{%- endcomment -%}
{%- if visibility == 'quiz' -%}
  data-ll-only="quiz"
{%- elsif visibility == 'direct' -%}
  data-ll-only="direct"
{%- endif -%}

<dl class="product-info">
    <dt class="h6">Formula Picker</dt>
    <div class="refill-formula-radio-group">
        {% comment %} <input type="radio" id="sensitive" name="refill-strength" value="🍃 Gentle (ID: 19-2)">
        <label for="sensitive">Sensitive</label> {% endcomment %}

        <input type="radio" id="medium" name="refill-strength" value="✨ Everyday (ID: 8-16)">
        <label for="medium">Standard</label>

        <input type="radio" id="strong" name="refill-strength" value="🔥 Super Strength (ID: 8-17)">
        <label for="strong" style = 'padding-right: 29px;'>Extra Strength <span class="price-difference">+$5</span></label>
    </div>
</dl>
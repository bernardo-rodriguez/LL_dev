{%- comment -%}
  v6 plan picker — the parts Skio does not render.

  Skio owns the cards, the selling-plan logic and the cart behaviour; this only
  adds the three things the v6 design shows that have no counterpart in Skio's
  markup: the "Choose your plan:" label above the picker, the three benefit
  tiles inside the subscribe card, and the one-line note under each card.

  It runs on the personalized template only — main-product.liquid renders this
  snippet behind a template.suffix check — so the production picker is
  untouched. Everything is inserted into Skio's shadow root after it renders;
  nothing here replaces or re-implements any of Skio's own markup.
{%- endcomment -%}

<script>
  (function () {
    var LABEL = {{ section.settings.plan_label | default: 'Choose your plan:' | json }};
    var RIBBON = {{ section.settings.plan_ribbon | default: '' | json }};
    var SUB_TITLE = {{ section.settings.plan_sub_title | default: '' | json }};
    var ONCE_TITLE = {{ section.settings.plan_once_title | default: '' | json }};
    var CTA_TEXT = {{ section.settings.plan_cta | default: '' | json }};
    var GUARANTEE = {{ section.settings.plan_guarantee | default: '' | json }};
    var SUB_NOTE = {{ section.settings.plan_sub_note | default: '' | json }};
    var ONCE_NOTE = {{ section.settings.plan_once_note | default: '' | json }};
    var BENEFITS = [
      { t: {{ section.settings.plan_benefit_1 | default: '' | json }}, s: {{ section.settings.plan_benefit_1_sub | default: '' | json }} },
      { t: {{ section.settings.plan_benefit_2 | default: '' | json }}, s: {{ section.settings.plan_benefit_2_sub | default: '' | json }} },
      { t: {{ section.settings.plan_benefit_3 | default: '' | json }}, s: {{ section.settings.plan_benefit_3_sub | default: '' | json }} }
    ].filter(function (b) { return b.t; });

    function el(tag, cls, text) {
      var n = document.createElement(tag);
      if (cls) n.className = cls;
      if (text) n.textContent = text;
      return n;
    }

    // Shadow DOM blocks selectors from outside, so the styling for the nodes
    // below has to be adopted into the root alongside them. Values here come
    // from the same palette tokens as the rest of the template, which do cross
    // the boundary.
    // Shadow DOM blocks selectors from outside, so the styling for these nodes
    // has to be adopted into the root alongside them. Because this sheet lives
    // inside the root it can also reach Skio's own elements directly, which is
    // how the pieces v6 drops are hidden. Palette tokens still cross in.
    var STYLE = [
      '.ll-plan-label{display:block;margin-bottom:2px;font-family:var(--v6-mono,ui-monospace,Menlo,monospace);',
      'font-size:11.5px;font-weight:500;letter-spacing:var(--v6-label-ls,.08em);',
      'text-transform:uppercase;color:var(--navy,#0D2244)}',

      /* Sentence case at the reference size, not bold uppercase */
      '.skio-group-title{text-transform:none!important;font-size:16px!important;font-weight:600!important;',
      'letter-spacing:0!important;color:var(--navy,#0D2244)!important}',

      /* A ring that fills in, rather than a solid disc */
      '.skio-radio__container svg circle:first-child{stroke:#9AA7B8;stroke-width:2}',
      '.skio-group-container--selected .skio-radio__container svg circle:first-child{stroke:var(--navy,#0D2244)}',
      '.skio-radio{color:var(--navy,#0D2244)!important;transform:scale(.52)!important;opacity:1!important}',
      '.skio-group-container--available:not(.skio-group-container--selected) .skio-radio{opacity:0!important}',

      '.ll-plan-benefits{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;width:100%}',
      '.ll-plan-benefit{display:flex;flex-direction:column;align-items:center;justify-content:flex-start;',
      'gap:5px;padding:10px 6px;text-align:center;background:#fff;border:1px solid var(--navy-tint-20,#CFD3DA)}',
      '.ll-plan-benefit svg{width:20px;height:20px;color:var(--pdp-accent,#2369c9);flex:none}',
      '.ll-plan-benefit__title{font-family:var(--v6-mono,ui-monospace,Menlo,monospace);font-size:10px;',
      'font-weight:500;line-height:1.25;letter-spacing:var(--v6-label-ls,.08em);',
      'text-transform:uppercase;color:var(--navy,#0D2244);min-height:2.5em;display:flex;align-items:center;',
      'justify-content:center}',
      '.ll-plan-benefit__sub{font-family:var(--ds-font-family,manrope,sans-serif);font-size:12px;',
      'line-height:1.2;color:var(--navy-tint-60,#6E7A8F);min-height:1.2em}',
      '.ll-plan-note{display:block;width:100%;font-family:var(--ds-font-family,manrope,sans-serif);',
      'font-size:13px;line-height:1.45;color:var(--navy-tint-60,#6E7A8F);text-align:left}',
      // The one-time card has no radio column of its own, so its note is
      // indented to sit under the title rather than under the dot.
      '.ll-plan-note--once{padding-left:32px}',

      /*
        On products Skio treats as non-kit, the subscribe card also carries a
        nested bundle price box and a list of plan checkmarks. The reference
        has neither — the card is title, price, benefit tiles, one note.
      */
      '.skio-group-content,.subscription_selling_plan_details{display:none!important}',

      /*
        v6 goes straight from the two cards to the CTA, so the itemised
        receipt, its heading and the total row are hidden. They are hidden,
        not removed: Skio owns that markup and still prices through it.
      */
      '.skio-first-order-includes{border:0!important;background:transparent!important;padding:0!important;',
      'margin-top:14px!important;display:flex;flex-direction:column;gap:14px}',
      '.skio-first-order-includes__title,.skio-first-order-item,.skio-total-row{display:none!important}',

      /* The CTA carries the price, as the reference does */
      '.add-to-cart.skio-includes-cta{width:100%;height:54px;margin:0!important;border:0!important;',
      'border-radius:2px!important;background:var(--navy,#0D2244)!important;color:#fff!important;',
      'font-family:var(--ds-font-family,manrope,sans-serif);font-size:14px!important;font-weight:600!important;',
      'letter-spacing:.08em!important;text-transform:uppercase!important;cursor:pointer}',

      /* The chip is mono like every other label */
      '.skio-save-ribbon{font-family:var(--v6-mono,ui-monospace,Menlo,monospace)!important;',
      'font-weight:500!important;letter-spacing:var(--v6-label-ls,.08em)!important}',

      /* 600, not the component's 700 */
      '.skio-plan-picker__purchase-row .skio-purchase-option-price span:not(.price--strike){',
      'font-weight:600!important}',
      '.skio-purchase-option-price .price--strike{color:var(--navy-tint-60,#6E7A8F)!important;',
      'font-weight:400!important;font-size:14px!important}',

      /* Skio's ships-every-60-days line is not in v6, and is subscription-only */
      '.skio-modify-disclaimer{display:none!important}',

      '.ll-plan-guarantee{display:flex;align-items:center;justify-content:center;gap:8px;',
      'font-family:var(--ds-font-family,manrope,sans-serif);font-size:13.5px;font-weight:500;',
      'line-height:1.35;color:var(--navy,#0D2244);text-align:center}',
      '.ll-plan-guarantee svg{width:16px;height:16px;flex:none;color:var(--pdp-accent,#2369c9)}'
    ].join('');

    var ICONS = [
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3h7l11 11-7 7L3 10z"/><circle cx="7.5" cy="7.5" r="1.3"/></svg>',
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 5h12v10H1z"/><path d="M13 8h4.5L22 11.5V15h-9"/><circle cx="6" cy="17.5" r="1.9"/><circle cx="17" cy="17.5" r="1.9"/></svg>',
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L20 8a2.8 2.8 0 0 0-4-4L4 16z"/></svg>'
    ];

    var SHIELD = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.8 20 6v6c0 4.6-3.3 8-8 9.2C7.3 20 4 16.6 4 12V6z"/><path d="m8.8 12 2.2 2.2 4.2-4.3"/></svg>';

    function decorate(picker) {
      var root = picker.shadowRoot;
      if (!root) return false;

      if (!root.querySelector('style[data-ll-v6]')) {
        var st = document.createElement('style');
        st.setAttribute('data-ll-v6', '');
        st.textContent = STYLE;
        root.appendChild(st);
      }

      var fieldset = root.querySelector('.skio-plan-picker');
      var row = root.querySelector('.skio-plan-picker__purchase-row');
      if (!fieldset || !row) return false;

      // The label belongs to the picker as a whole, so it goes above the row
      if (LABEL && !root.querySelector('.ll-plan-label')) {
        var lab = el('span', 'll-plan-label', LABEL);
        row.parentNode.insertBefore(lab, row);
      }

      // Skio hardcodes the chip text; v6 words it as a recommendation rather
      // than a discount, so it is retitled in place.
      var ribbon = root.querySelector('.skio-subscription-first .skio-save-ribbon');
      if (RIBBON && ribbon && ribbon.textContent.trim() !== RIBBON) {
        ribbon.textContent = RIBBON;
      }

      // Skio hardcodes both plan titles in caps; v6 sets them in sentence case
      var subTitle = root.querySelector('.skio-subscription-first .skio-group-title');
      if (SUB_TITLE && subTitle && subTitle.textContent.trim() !== SUB_TITLE) subTitle.textContent = SUB_TITLE;
      var onceTitle = root.querySelector('.skio-onetime-second .skio-group-title');
      if (ONCE_TITLE && onceTitle && onceTitle.textContent.trim() !== ONCE_TITLE) onceTitle.textContent = ONCE_TITLE;

      var subLabel = root.querySelector('.skio-subscription-first .skio-group-label');
      if (subLabel && BENEFITS.length && !root.querySelector('.ll-plan-benefits')) {
        var grid = el('span', 'll-plan-benefits');
        BENEFITS.forEach(function (b, i) {
          var cell = el('span', 'll-plan-benefit');
          if (ICONS[i]) {
            var ic = document.createElement('span');
            ic.innerHTML = ICONS[i];
            cell.appendChild(ic.firstChild);
          }
          cell.appendChild(el('span', 'll-plan-benefit__title', b.t));
          // The sub line is always present so the three tiles stay the same
          // height whether or not each one has a second line.
          cell.appendChild(el('span', 'll-plan-benefit__sub', b.s || ' '));
          grid.appendChild(cell);
        });
        subLabel.appendChild(grid);
      }

      if (SUB_NOTE && subLabel && !root.querySelector('.ll-plan-note--sub')) {
        subLabel.appendChild(el('span', 'll-plan-note ll-plan-note--sub', SUB_NOTE));
      }

      var onceLabel = root.querySelector('.skio-onetime-second .skio-group-label');
      if (ONCE_NOTE && onceLabel && !root.querySelector('.ll-plan-note--once')) {
        onceLabel.appendChild(el('span', 'll-plan-note ll-plan-note--once', ONCE_NOTE));
      }

      // v6 puts the price on the button. The price comes off the selected
      // card rather than the total row: Skio renders no total row on the
      // one-time plan, which left the button with no figure at all.
      // Skio only renders its own CTA inside the includes block, and that
      // block exists on kit products only. Everywhere else the real button
      // is the theme's, outside the shadow root — so fall back to it.
      var cta = root.querySelector('.add-to-cart.skio-includes-cta');
      var inShadow = !!cta;
      if (!cta) cta = document.querySelector('.product-form__buttons .product-form__submit');

      if (CTA_TEXT && cta) {
        var picked = root.querySelector('.skio-group-container--selected .skio-purchase-option-price span:not(.price--strike)')
          || root.querySelector('.skio-total-row .price--current');
        var want = CTA_TEXT + (picked ? ' · ' + picked.textContent.replace(/\s+/g, '') : '');
        var holder = cta.querySelector('span') || cta;
        if (holder.textContent.trim() !== want) holder.textContent = want;
        if (!inShadow) cta.classList.add('ll-plan-cta');
      }

      // Skio's own disclaimer is subscription-only, so the guarantee is our
      // own node after the button and shows on either plan. Skio's line is
      // hidden by the stylesheet rather than rewritten in place.
      var scope = inShadow ? root : document;
      if (GUARANTEE && cta && !scope.querySelector('.ll-plan-guarantee')) {
        var gline = el('span', 'll-plan-guarantee');
        gline.innerHTML = SHIELD;
        gline.appendChild(document.createTextNode(GUARANTEE));
        cta.parentNode.insertBefore(gline, cta.nextSibling);
      }
      return true;
    }

    function start() {
      var picker = document.querySelector('skio-plan-picker');
      if (!picker) return;
      if (decorate(picker)) {
        // Skio re-renders its own markup on selection changes, which drops
        // these nodes; re-adding them is cheap and the guards make it a no-op
        // when they are already there.
        if (picker.shadowRoot) {
          new MutationObserver(function () { decorate(picker); })
            .observe(picker.shadowRoot, { childList: true, subtree: true });
        }
        return;
      }
      var tries = 0;
      var t = setInterval(function () {
        if (decorate(picker) || ++tries > 40) {
          clearInterval(t);
          if (picker.shadowRoot) {
            new MutationObserver(function () { decorate(picker); })
              .observe(picker.shadowRoot, { childList: true, subtree: true });
          }
        }
      }, 250);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start);
    } else {
      start();
    }
  })();
</script>

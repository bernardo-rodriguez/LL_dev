{% capture guarantee_icon %}
{{ 'icons8-guarantee.svg' | asset_url | file_read }}
{% endcapture %}

<div>
    <div style="width: 20px; height: 20px; display: inline-block; vertical-align: middle;">
        {{ guarantee_icon }}
    </div>
    {% comment %} <img width = '20' height = '20' loading = 'lazy' src="{{ 'icons8-guarantee.svg' | asset_url }}" style = 'display: inline-block; vertical-align: middle'> {% endcomment %}
    <p id = 'estimated_arrival_pdp' style = 'padding-top: 5px; display: inline-block'></p>
</div>

<script>
let today = new Date();
let nextThreeDays = new Date(today. setDate(today. getDate() + 3));
let monthNames = ["January", "February", "March", "April", "May", "June",
  "July", "August", "September", "October", "November", "December"
];
let monthName = monthNames[nextThreeDays.getMonth()];

document.getElementById('estimated_arrival_pdp').innerHTML = "Estimated arrival " + monthName + ' ' + nextThreeDays.getDate()
</script>
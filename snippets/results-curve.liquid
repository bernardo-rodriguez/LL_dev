{%- comment -%}
  Illustrative results curve for the Why Subscribe panel.

  A single-series logarithmic line: steep early gains, then smaller but
  continuing ones — the point being that results compound with continued use.
  The curve geometry is fixed (Liquid has no log filter, and a merchant-editable
  curve would let the dots drift off the path); the labels are editable.

  Colours follow the marks spec: 2px navy line on a 10% blue wash, hairline
  solid gridlines, 8px dots with a 2px surface ring, and all text in ink
  tokens rather than the series colour. Single series, so no legend.

  Accepts: points (textarea, "label | caption" per line, 2-5 lines),
           highlight (text, callout on the final point),
           caption (text, below the chart)
{%- endcomment -%}

{%- assign lines = points | default: '' | newline_to_br | split: '<br />' -%}
{%- assign clean = '' -%}
{%- for line in lines -%}
  {%- assign t = line | strip -%}
  {%- if t != blank -%}
    {%- if clean == '' -%}{%- assign clean = t -%}{%- else -%}{%- assign clean = clean | append: '||' | append: t -%}{%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- assign items = clean | split: '||' -%}
{%- assign n = items.size -%}

{%- if n >= 2 -%}
  {%- comment -%} Dot positions precomputed on the same log curve, per point count {%- endcomment -%}
  {%- case n -%}
    {%- when 2 -%}
      {%- assign xs = '10,310' | split: ',' -%}
      {%- assign ys = '112,14' | split: ',' -%}
    {%- when 3 -%}
      {%- assign xs = '10,160,310' | split: ',' -%}
      {%- assign ys = '112,39.4,14' | split: ',' -%}
    {%- when 4 -%}
      {%- assign xs = '10,110,210,310' | split: ',' -%}
      {%- assign ys = '112,53,29.2,14' | split: ',' -%}
    {%- else -%}
      {%- assign xs = '10,85,160,235,310' | split: ',' -%}
      {%- assign ys = '112,61.8,39.4,24.8,14' | split: ',' -%}
  {%- endcase -%}

  <figure class="results-curve">
    <svg
      class="results-curve__svg"
      viewBox="0 0 320 150"
      role="img"
      aria-label="{{ aria | default: 'Whitening results over time: fast early gains that keep building with continued use.' | escape }}"
      focusable="false"
    >
      {%- comment -%} Recessive gridlines: hairline, solid {%- endcomment -%}
      <g class="results-curve__grid" aria-hidden="true">
        <line x1="10" y1="87.5" x2="310" y2="87.5"></line>
        <line x1="10" y1="63" x2="310" y2="63"></line>
        <line x1="10" y1="38.5" x2="310" y2="38.5"></line>
        <line x1="10" y1="14" x2="310" y2="14"></line>
      </g>
      <line class="results-curve__axis" x1="10" y1="112" x2="310" y2="112" aria-hidden="true"></line>

      <path class="results-curve__area" aria-hidden="true" d="M 10.0,112.0 L 15.0,106.1 L 20.0,100.8 L 25.0,96.2 L 30.0,92.0 L 35.0,88.2 L 40.0,84.7 L 45.0,81.4 L 50.0,78.4 L 55.0,75.6 L 60.0,73.0 L 65.0,70.5 L 70.0,68.2 L 75.0,66.0 L 80.0,63.8 L 85.0,61.8 L 90.0,59.9 L 95.0,58.1 L 100.0,56.3 L 105.0,54.6 L 110.0,53.0 L 115.0,51.4 L 120.0,49.9 L 125.0,48.5 L 130.0,47.0 L 135.0,45.7 L 140.0,44.4 L 145.0,43.1 L 150.0,41.8 L 155.0,40.6 L 160.0,39.4 L 165.0,38.3 L 170.0,37.2 L 175.0,36.1 L 180.0,35.0 L 185.0,34.0 L 190.0,33.0 L 195.0,32.0 L 200.0,31.0 L 205.0,30.1 L 210.0,29.2 L 215.0,28.3 L 220.0,27.4 L 225.0,26.5 L 230.0,25.7 L 235.0,24.8 L 240.0,24.0 L 245.0,23.2 L 250.0,22.4 L 255.0,21.7 L 260.0,20.9 L 265.0,20.2 L 270.0,19.4 L 275.0,18.7 L 280.0,18.0 L 285.0,17.3 L 290.0,16.6 L 295.0,16.0 L 300.0,15.3 L 305.0,14.6 L 310.0,14.0 L 310.0,112.0 L 10.0,112.0 Z"></path>
      <path class="results-curve__line" aria-hidden="true" fill="none" d="M 10.0,112.0 L 15.0,106.1 L 20.0,100.8 L 25.0,96.2 L 30.0,92.0 L 35.0,88.2 L 40.0,84.7 L 45.0,81.4 L 50.0,78.4 L 55.0,75.6 L 60.0,73.0 L 65.0,70.5 L 70.0,68.2 L 75.0,66.0 L 80.0,63.8 L 85.0,61.8 L 90.0,59.9 L 95.0,58.1 L 100.0,56.3 L 105.0,54.6 L 110.0,53.0 L 115.0,51.4 L 120.0,49.9 L 125.0,48.5 L 130.0,47.0 L 135.0,45.7 L 140.0,44.4 L 145.0,43.1 L 150.0,41.8 L 155.0,40.6 L 160.0,39.4 L 165.0,38.3 L 170.0,37.2 L 175.0,36.1 L 180.0,35.0 L 185.0,34.0 L 190.0,33.0 L 195.0,32.0 L 200.0,31.0 L 205.0,30.1 L 210.0,29.2 L 215.0,28.3 L 220.0,27.4 L 225.0,26.5 L 230.0,25.7 L 235.0,24.8 L 240.0,24.0 L 245.0,23.2 L 250.0,22.4 L 255.0,21.7 L 260.0,20.9 L 265.0,20.2 L 270.0,19.4 L 275.0,18.7 L 280.0,18.0 L 285.0,17.3 L 290.0,16.6 L 295.0,16.0 L 300.0,15.3 L 305.0,14.6 L 310.0,14.0"></path>

      {%- comment -%} Milestone dots + x labels. Last one is the emphasis. {%- endcomment -%}
      {%- for item in items -%}
        {%- assign parts = item | split: '|' -%}
        {%- assign cx = xs[forloop.index0] -%}
        {%- assign cy = ys[forloop.index0] -%}
        {%- assign is_last = false -%}
        {%- if forloop.last -%}{%- assign is_last = true -%}{%- endif -%}

        <circle
          class="results-curve__dot {% if is_last %}results-curve__dot--end{% endif %}"
          cx="{{ cx }}"
          cy="{{ cy }}"
          r="{% if is_last %}5{% else %}4{% endif %}"
        ></circle>

        <text
          class="results-curve__x-label"
          x="{{ cx }}"
          y="126"
          text-anchor="{% if forloop.first %}start{% elsif is_last %}end{% else %}middle{% endif %}"
        >{{ parts[0] | strip }}</text>

        {%- if parts.size > 1 -%}
          <text
            class="results-curve__x-sub"
            x="{{ cx }}"
            y="140"
            text-anchor="{% if forloop.first %}start{% elsif is_last %}end{% else %}middle{% endif %}"
          >{{ parts[1] | strip }}</text>
        {%- endif -%}
      {%- endfor -%}
    </svg>

    {%- if highlight != blank -%}
      <p class="results-curve__highlight sh3">
        <span class="results-curve__highlight-dot" aria-hidden="true"></span>{{ highlight }}
      </p>
    {%- endif -%}

    {%- if caption != blank -%}
      <figcaption class="results-curve__caption body-xs">{{ caption }}</figcaption>
    {%- endif -%}
  </figure>
{%- endif -%}

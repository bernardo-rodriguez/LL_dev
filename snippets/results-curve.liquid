{%- comment -%}
  Compact results curve for the Why Subscribe panel.

  Single-series logarithmic line: steep early gains, then smaller but
  continuing ones — results compound with continued use.

  All text lives in HTML, never inside the SVG. SVG text scales with the
  viewBox, so a 10px label rendered ~3x too large in a wide panel and the
  labels collided. Only the curve, wash, gridlines and dots are SVG; strokes
  use non-scaling-stroke so weights stay true at any width.

  Accepts: points (textarea, one short label per line, 2-5)
           highlight (text, one line under the chart)
{%- endcomment -%}

{%- assign lines = points | default: '' | newline_to_br | split: '<br />' -%}
{%- assign clean = '' -%}
{%- for line in lines -%}
  {%- assign t = line | strip -%}
  {%- if t != blank -%}
    {%- if clean == '' -%}{%- assign clean = t -%}{%- else -%}{%- assign clean = clean | append: '||' | append: t -%}{%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- assign items = clean | split: '||' -%}
{%- assign n = items.size -%}

{%- if n >= 2 -%}
  {%- case n -%}
    {%- when 2 -%}
      {%- assign xs = '6,314' | split: ',' -%}
      {%- assign ys = '94,10' | split: ',' -%}
    {%- when 3 -%}
      {%- assign xs = '6,160,314' | split: ',' -%}
      {%- assign ys = '94,31.8,10' | split: ',' -%}
    {%- when 4 -%}
      {%- assign xs = '6,108.7,211.3,314' | split: ',' -%}
      {%- assign ys = '94,43.4,23,10' | split: ',' -%}
    {%- else -%}
      {%- assign xs = '6,83,160,237,314' | split: ',' -%}
      {%- assign ys = '94,51,31.8,19.3,10' | split: ',' -%}
  {%- endcase -%}

  <figure class="results-curve">
    <svg
      class="results-curve__svg"
      viewBox="0 0 320 104"
      role="img"
      aria-label="{{ aria | default: 'Whitening results over time: fast early gains that keep building with continued use.' | escape }}"
      focusable="false"
    >
      <g class="results-curve__grid" aria-hidden="true">
        <line x1="6" y1="66" x2="314" y2="66"></line>
        <line x1="6" y1="38" x2="314" y2="38"></line>
      </g>
      <line class="results-curve__axis" x1="6" y1="94" x2="314" y2="94" aria-hidden="true"></line>

      <path class="results-curve__area" aria-hidden="true" d="M 6.0,94.0 L 11.1,88.9 L 16.3,84.4 L 21.4,80.4 L 26.5,76.9 L 31.7,73.6 L 36.8,70.6 L 41.9,67.8 L 47.1,65.2 L 52.2,62.8 L 57.3,60.6 L 62.5,58.4 L 67.6,56.4 L 72.7,54.5 L 77.9,52.7 L 83.0,51.0 L 88.1,49.4 L 93.3,47.8 L 98.4,46.3 L 103.5,44.8 L 108.7,43.4 L 113.8,42.1 L 118.9,40.8 L 124.1,39.5 L 129.2,38.3 L 134.3,37.2 L 139.5,36.0 L 144.6,34.9 L 149.7,33.9 L 154.9,32.8 L 160.0,31.8 L 165.1,30.8 L 170.3,29.9 L 175.4,28.9 L 180.5,28.0 L 185.7,27.1 L 190.8,26.3 L 195.9,25.4 L 201.1,24.6 L 206.2,23.8 L 211.3,23.0 L 216.5,22.2 L 221.6,21.5 L 226.7,20.7 L 231.9,20.0 L 237.0,19.3 L 242.1,18.6 L 247.3,17.9 L 252.4,17.2 L 257.5,16.6 L 262.7,15.9 L 267.8,15.3 L 272.9,14.7 L 278.1,14.0 L 283.2,13.4 L 288.3,12.8 L 293.5,12.3 L 298.6,11.7 L 303.7,11.1 L 308.9,10.6 L 314.0,10.0 L 314.0,94.0 L 6.0,94.0 Z"></path>
      <path class="results-curve__line" aria-hidden="true" fill="none" d="M 6.0,94.0 L 11.1,88.9 L 16.3,84.4 L 21.4,80.4 L 26.5,76.9 L 31.7,73.6 L 36.8,70.6 L 41.9,67.8 L 47.1,65.2 L 52.2,62.8 L 57.3,60.6 L 62.5,58.4 L 67.6,56.4 L 72.7,54.5 L 77.9,52.7 L 83.0,51.0 L 88.1,49.4 L 93.3,47.8 L 98.4,46.3 L 103.5,44.8 L 108.7,43.4 L 113.8,42.1 L 118.9,40.8 L 124.1,39.5 L 129.2,38.3 L 134.3,37.2 L 139.5,36.0 L 144.6,34.9 L 149.7,33.9 L 154.9,32.8 L 160.0,31.8 L 165.1,30.8 L 170.3,29.9 L 175.4,28.9 L 180.5,28.0 L 185.7,27.1 L 190.8,26.3 L 195.9,25.4 L 201.1,24.6 L 206.2,23.8 L 211.3,23.0 L 216.5,22.2 L 221.6,21.5 L 226.7,20.7 L 231.9,20.0 L 237.0,19.3 L 242.1,18.6 L 247.3,17.9 L 252.4,17.2 L 257.5,16.6 L 262.7,15.9 L 267.8,15.3 L 272.9,14.7 L 278.1,14.0 L 283.2,13.4 L 288.3,12.8 L 293.5,12.3 L 298.6,11.7 L 303.7,11.1 L 308.9,10.6 L 314.0,10.0"></path>

      {%- for item in items -%}
        <circle
          class="results-curve__dot {% if forloop.last %}results-curve__dot--end{% endif %}"
          cx="{{ xs[forloop.index0] }}"
          cy="{{ ys[forloop.index0] }}"
          r="{% if forloop.last %}4.5{% else %}3.5{% endif %}"
        ></circle>
      {%- endfor -%}
    </svg>

    {%- comment -%} Labels in HTML: evenly spaced, matching the evenly spaced dots {%- endcomment -%}
    <div class="results-curve__labels" aria-hidden="true">
      {%- for item in items -%}
        <span class="results-curve__label {% if forloop.last %}results-curve__label--end{% endif %}">{{ item | strip }}</span>
      {%- endfor -%}
    </div>

    {%- if highlight != blank -%}
      <figcaption class="results-curve__highlight body-xs">{{ highlight }}</figcaption>
    {%- endif -%}
  </figure>
{%- endif -%}

{%- comment -%}
  Compact results curve for the Why Subscribe panel.

  Single-series growth curve through fixed milestones: fast early gains that
  keep compounding — roughly +50% from 6 to 12 sessions, then a further +30%
  by 20+. Fitted with monotone cubic interpolation so it passes through each
  milestone without overshooting.

  All text lives in HTML, never inside the SVG. SVG text scales with the
  viewBox, so a 10px label rendered ~3x too large in a wide panel and the
  labels collided. Only the curve, wash, gridlines and dots are SVG; strokes
  use non-scaling-stroke so weights stay true at any width.

  Accepts: points (textarea, one short label per line, 2-5)
           highlight (text, one line under the chart)
{%- endcomment -%}

{%- assign lines = points | default: '' | newline_to_br | split: '<br />' -%}
{%- assign clean = '' -%}
{%- for line in lines -%}
  {%- assign t = line | strip -%}
  {%- if t != blank -%}
    {%- if clean == '' -%}{%- assign clean = t -%}{%- else -%}{%- assign clean = clean | append: '||' | append: t -%}{%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- assign items = clean | split: '||' -%}
{%- assign n = items.size -%}

{%- if n >= 2 -%}
  {%- case n -%}
    {%- when 2 -%}
      {%- assign xs = '6,314' | split: ',' -%}
      {%- assign ys = '94,10' | split: ',' -%}
    {%- when 3 -%}
      {%- assign xs = '6,160,314' | split: ',' -%}
      {%- assign ys = '94,39.1,10' | split: ',' -%}
    {%- when 4 -%}
      {%- assign xs = '6,108.7,211.3,314' | split: ',' -%}
      {%- assign ys = '94,50.9,29.4,10' | split: ',' -%}
    {%- else -%}
      {%- assign xs = '6,83,160,237,314' | split: ',' -%}
      {%- assign ys = '94,59.7,39.1,24.4,10' | split: ',' -%}
  {%- endcase -%}

  <figure class="results-curve">
    <svg
      class="results-curve__svg"
      viewBox="0 0 320 100"
      role="img"
      aria-label="{{ aria | default: 'Whitening results over time: fast early gains that keep building with continued use.' | escape }}"
      focusable="false"
    >
      <g class="results-curve__grid" aria-hidden="true">
        <line x1="6" y1="66" x2="314" y2="66"></line>
        <line x1="6" y1="38" x2="314" y2="38"></line>
      </g>
      <line class="results-curve__axis" x1="6" y1="94" x2="314" y2="94" aria-hidden="true"></line>

      <path class="results-curve__area" aria-hidden="true" d="M 6.0,94.0 L 11.1,91.8 L 16.3,89.6 L 21.4,87.3 L 26.5,84.9 L 31.7,82.6 L 36.8,80.2 L 41.9,77.8 L 47.1,75.4 L 52.2,73.0 L 57.3,70.7 L 62.5,68.4 L 67.6,66.1 L 72.7,63.9 L 77.9,61.7 L 83.0,59.7 L 88.1,57.7 L 93.3,55.8 L 98.4,54.1 L 103.5,52.4 L 108.7,50.9 L 113.8,49.5 L 118.9,48.2 L 124.1,46.9 L 129.2,45.7 L 134.3,44.5 L 139.5,43.3 L 144.6,42.2 L 149.7,41.2 L 154.9,40.1 L 160.0,39.1 L 165.1,38.1 L 170.3,37.1 L 175.4,36.2 L 180.5,35.2 L 185.7,34.3 L 190.8,33.3 L 195.9,32.4 L 201.1,31.4 L 206.2,30.4 L 211.3,29.4 L 216.5,28.4 L 221.6,27.4 L 226.7,26.4 L 231.9,25.4 L 237.0,24.4 L 242.1,23.4 L 247.3,22.4 L 252.4,21.5 L 257.5,20.5 L 262.7,19.6 L 267.8,18.6 L 272.9,17.7 L 278.1,16.7 L 283.2,15.8 L 288.3,14.8 L 293.5,13.8 L 298.6,12.9 L 303.7,11.9 L 308.9,11.0 L 314.0,10.0 L 314.0,94.0 L 6.0,94.0 Z"></path>
      <path class="results-curve__line" aria-hidden="true" fill="none" d="M 6.0,94.0 L 11.1,91.8 L 16.3,89.6 L 21.4,87.3 L 26.5,84.9 L 31.7,82.6 L 36.8,80.2 L 41.9,77.8 L 47.1,75.4 L 52.2,73.0 L 57.3,70.7 L 62.5,68.4 L 67.6,66.1 L 72.7,63.9 L 77.9,61.7 L 83.0,59.7 L 88.1,57.7 L 93.3,55.8 L 98.4,54.1 L 103.5,52.4 L 108.7,50.9 L 113.8,49.5 L 118.9,48.2 L 124.1,46.9 L 129.2,45.7 L 134.3,44.5 L 139.5,43.3 L 144.6,42.2 L 149.7,41.2 L 154.9,40.1 L 160.0,39.1 L 165.1,38.1 L 170.3,37.1 L 175.4,36.2 L 180.5,35.2 L 185.7,34.3 L 190.8,33.3 L 195.9,32.4 L 201.1,31.4 L 206.2,30.4 L 211.3,29.4 L 216.5,28.4 L 221.6,27.4 L 226.7,26.4 L 231.9,25.4 L 237.0,24.4 L 242.1,23.4 L 247.3,22.4 L 252.4,21.5 L 257.5,20.5 L 262.7,19.6 L 267.8,18.6 L 272.9,17.7 L 278.1,16.7 L 283.2,15.8 L 288.3,14.8 L 293.5,13.8 L 298.6,12.9 L 303.7,11.9 L 308.9,11.0 L 314.0,10.0"></path>

      {%- comment -%} Ticks below the axis so each label reads against its own point {%- endcomment -%}
      {%- for item in items -%}
        <line
          class="results-curve__tick"
          x1="{{ xs[forloop.index0] }}"
          y1="94"
          x2="{{ xs[forloop.index0] }}"
          y2="100"
          aria-hidden="true"
        ></line>
      {%- endfor -%}

      {%- for item in items -%}
        <circle
          class="results-curve__dot {% if forloop.last %}results-curve__dot--end{% endif %}"
          cx="{{ xs[forloop.index0] }}"
          cy="{{ ys[forloop.index0] }}"
          r="{% if forloop.last %}4.5{% else %}3.5{% endif %}"
        ></circle>
      {%- endfor -%}
    </svg>

    {%- comment -%} Labels in HTML: evenly spaced, matching the evenly spaced dots {%- endcomment -%}
    <div class="results-curve__labels" aria-hidden="true">
      {%- for item in items -%}
        <span class="results-curve__label {% if forloop.last %}results-curve__label--end{% endif %}">{{ item | strip }}</span>
      {%- endfor -%}
    </div>

    {%- if highlight != blank -%}
      <figcaption class="results-curve__highlight body-xs">{{ highlight }}</figcaption>
    {%- endif -%}
  </figure>
{%- endif -%}

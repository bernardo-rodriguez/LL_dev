{%- comment -%}
  The v4 gallery — a square frame with a caption strip, over four labelled
  thumbnails.

  This is its own markup rather than a restyle of the swiper gallery: the comp
  labels its thumbnails by role (Kit / Box / Results / How to) rather than
  showing image previews, which the existing component has no way to express.

  Rendered only when main-product is on the personalized template, so the
  production PDP keeps the swiper gallery exactly as it is.

  The thumbnails are previews of the images themselves. The labels from the
  section's comma-separated list name them for screen readers — the picture
  carries the meaning for everyone else, and alt is the product title on
  every image, so it says nothing useful here.
{%- endcomment -%}

{% assign gallery_media = product.media | default: empty %}
{% assign thumb_labels = section.settings.gallery_labels | split: ',' %}

<div class="pdp-gallery" data-pdp-gallery>
  <div class="pdp-gallery__frame">
    {% for media in gallery_media %}
      <figure
        class="pdp-gallery__slide{% if forloop.first %} pdp-gallery__slide--on{% endif %}"
        data-gallery-slide="{{ forloop.index0 }}"
        {% unless forloop.first %}hidden{% endunless %}
      >
        <img
          src="{{ media | image_url: width: 1200 }}"
          alt="{{ media.alt | escape }}"
          loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
          width="{{ media.width }}"
          height="{{ media.height }}"
        >
      </figure>
    {% endfor %}

    {% if section.settings.gallery_caption != blank %}
      <span class="pdp-gallery__caption">{{ section.settings.gallery_caption }}</span>
    {% endif %}
  </div>

  {%- comment -%}
    One thumbnail per image. The row fits four and scrolls past that, rather
    than capping: a capped list left any image beyond the fourth with nothing
    to select it.
  {%- endcomment -%}
  {% if gallery_media.size > 1 %}
    <div class="pdp-gallery__thumbs" role="tablist" aria-label="Product images">
      {% for media in gallery_media %}
        <button
          type="button"
          class="pdp-gallery__thumb{% if forloop.first %} pdp-gallery__thumb--on{% endif %}"
          data-gallery-thumb="{{ forloop.index0 }}"
          role="tab"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          {%- assign label = thumb_labels[forloop.index0] | strip -%}
          aria-label="{{ label | default: forloop.index | escape }}"
        >
          <img
            src="{{ media | image_url: width: 240 }}"
            alt=""
            loading="lazy"
            width="120"
            height="120"
          >
        </button>
      {% endfor %}
    </div>
  {% endif %}
</div>

<script>
  (function () {
    var root = document.querySelector('[data-pdp-gallery]');
    if (!root) return;
    var thumbs = root.querySelectorAll('[data-gallery-thumb]');
    var slides = root.querySelectorAll('[data-gallery-slide]');
    if (thumbs.length < 2) return;

    thumbs.forEach(function (thumb) {
      thumb.addEventListener('click', function () {
        var want = thumb.getAttribute('data-gallery-thumb');
        thumbs.forEach(function (t) {
          var on = t === thumb;
          t.classList.toggle('pdp-gallery__thumb--on', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        slides.forEach(function (s) {
          var on = s.getAttribute('data-gallery-slide') === want;
          s.hidden = !on;
          s.classList.toggle('pdp-gallery__slide--on', on);
        });
      });
    });
  })();
</script>

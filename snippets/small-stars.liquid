<style>
  .small-stars-section .jdgm-star::before {
    color: #000 !important;
    font-size: 12px !important;
  }
  .small-stars-section .jdgm-star {
    padding: 0 !important;
  }
  .small-stars-section {
    font-family: manrope, sans-serif;
    font-size: 14px;
    line-height: 1.3;
    font-weight: 600;
    margin-top: 0;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .small-stars-rating {
    margin-right: 6px;
  }
</style>

<div class="small-stars-section">
  <span class="jdgm-star jdgm--on"></span>
  <span class="jdgm-star jdgm--on"></span>
  <span class="jdgm-star jdgm--on"></span>
  <span class="jdgm-star jdgm--on"></span>
  <span class="jdgm-star jdgm--half"></span>
  {%- comment -%}
    The rating reads as one link to the reviews further down the page, which
    is how the design treats it. The anchor is resolved by script so it works
    wherever the reviews section sits on a given template.
  {%- endcomment -%}
  {%- comment -%}
    No whitespace between the two spans: a collapsed text node there is not
    painted by the link's underline and leaves a visible break in the rule.
    The spacing comes from the separator instead.
  {%- endcomment -%}
  <a class="small-stars-link" href="#reviews" data-stars-to-reviews
    ><span class="small-stars-rating">4.7<span class="small-stars-outof">/5</span></span
    ><span class="small-stars-review-count"></span
  ></a>
</div>

<script>
  (function() {
    function getReviewCountFromElement(el) {
      if (!el || !el.textContent) return null;
      var match = el.textContent.match(/based on (\d[\d,]*)\s*reviews?/i);
      return match ? parseInt(match[1].replace(/,/g, ''), 10) : null;
    }
    function updateSmallStarsReviewCount() {
      var summaryText = document.querySelector('.jdgm-rev-widg__summary-text');
      var allReviewsText = document.querySelector('.jdgm-all-reviews-text__text');
      var rawCount = null;
      if (summaryText) rawCount = getReviewCountFromElement(summaryText);
      if (rawCount == null && allReviewsText) rawCount = getReviewCountFromElement(allReviewsText);
      // Templates without the full reviews widget on the page (the personalized
      // PDP, for one) have neither element, so the count never filled in. The
      // preview badge carries the same raw number as an attribute.
      if (rawCount == null) {
        var prevBadge = document.querySelector('.jdgm-prev-badge[data-number-of-reviews]');
        if (prevBadge) {
          var attr = parseInt(prevBadge.getAttribute('data-number-of-reviews'), 10);
          if (!isNaN(attr)) rawCount = attr;
        }
      }
      if (rawCount != null) {
        var displayCount = rawCount < 1000 ? rawCount + 2000 : rawCount;
        var text = displayCount.toLocaleString() + ' Reviews';
        document.querySelectorAll('.small-stars-review-count').forEach(function(el) { el.textContent = text; });
        return true;
      }
      return false;
    }
    // Point the rating at whichever section carries the reviews on this page.
    function wireReviewsLink() {
      var link = document.querySelector('[data-stars-to-reviews]');
      if (!link) return;
      var target = document.querySelector('#reviews, .results-cards, #judgeme_product_reviews, .jdgm-rev-widg');
      if (!target) return;
      link.addEventListener('click', function (e) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', wireReviewsLink);
    } else {
      wireReviewsLink();
    }

    if (!updateSmallStarsReviewCount()) {
      var obs = new MutationObserver(function(mutations, observer) {
        if (updateSmallStarsReviewCount()) observer.disconnect();
      });
      obs.observe(document.body, { childList: true, subtree: true, characterData: true });
      setTimeout(updateSmallStarsReviewCount, 2000);
      setTimeout(updateSmallStarsReviewCount, 5000);
      setTimeout(updateSmallStarsReviewCount, 10000);
    }
  })();
</script>

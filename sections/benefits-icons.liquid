{{ 'section-key-benefits-list.css' | asset_url | stylesheet_tag }}

<section class="key-benefits-list" id="benefits-icons-{{ section.id }}">
  <div class="page-width">
    <div class="key-benefits-list__inner">
      {% if section.settings.heading != blank %}
        <h3 class="key-benefits-list__title h3">{{ section.settings.heading }}</h3>
      {% endif %}
      <div class="key-benefits-list__grid">
        {% for block in section.blocks %}
          {% if block.type == 'benefit_item' %}
            <div class="key-benefits-list__item" {{ block.shopify_attributes }}>
              <div class="key-benefits-list__item-icon-wrap">
                <div class="key-benefits-list__item-icon">
                  {% if block.settings.image != blank %}
                    <img
                      src="{{ block.settings.image | image_url: width: 160 }}"
                      alt="{{ block.settings.title | escape }}"
                      width="80"
                      height="80"
                      loading="lazy"
                    >
                  {% else %}
                    <span class="key-benefits-list__item-placeholder" aria-hidden="true"></span>
                  {% endif %}
                </div>
              </div>
              <div class="key-benefits-list__item-content">
                {% if block.settings.title != blank %}
                  <p class="key-benefits-list__item-title sh2">{{ block.settings.title }}</p>
                {% endif %}
                {% if block.settings.description != blank %}
                  <div class="key-benefits-list__item-description body-sm">{{ block.settings.description | newline_to_br }}</div>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Key Benefits",
  "tag": "section",
  "class": "section-benefits-icons",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": ""
    }
  ],
  "blocks": [
    {
      "name": "Benefit",
      "type": "benefit_item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon / Image",
          "info": "Leave empty for light blue circle placeholder"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Benefit title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Insert description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Key Benefits",
      "settings": {},
      "blocks": [
        {
          "type": "benefit_item",
          "settings": {
            "title": "Stronger & Quicker Than Generic",

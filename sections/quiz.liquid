<script src="{{ 'quiz.js' | asset_url }}" defer="defer"></script>
{{ 'section-quiz.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Critical hidden state, inlined so it applies on first paint.

  This section renders near the end of the document, and the closed state of
  the quiz lives only in section-quiz.css. Until that file arrives the quiz
  has no styles at all, so it lays out as a normal block in the flow and is
  visible — obvious on a slow connection. When the stylesheet finally applied,
  its `transition: opacity .5s ease 1.3s` then animated the quiz away, which is
  the lingering fade rather than an instant disappearance.

  These declarations duplicate the base rule in section-quiz.css exactly, so
  the value never changes once that file loads and no transition is triggered.
{%- endcomment -%}
<style>
  .quiz {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -3334;
    opacity: 0;
  }
</style>

{%- comment -%}
  The quiz is built from blocks: a `step` opens a screen, `question` blocks
  sit inside it, and the `option` blocks after a question are its answers.
  Consecutive `text_input` blocks share one row. `snippet` is the escape
  hatch for the two screens that are not question-and-answer — the shade
  sliders and the final report.

  quiz.js addresses steps by number and answers by input `name`, so the step
  order here and the Name field on each question are the contract with it.
  Renaming a question's Name detaches it from the formula and from Klaviyo.
{%- endcomment -%}


<formula-quiz data-state="1">
  <section class="quiz" aria-hidden="true">
    <div class="quiz__inner">
      <div class="quiz__header">
        <div class="quiz__logo">
          {% if section.settings.quiz_svg_logo != blank %}
            <div class="quiz__logo-svg">
              {{ section.settings.quiz_svg_logo }}
            </div>
          {% endif %}
        </div>

        <button class="quiz__close">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <line x1="15.1944" y1="1.05253" x2="1.05224" y2="15.1947" stroke="#0D2244"/>
            <path d="M15.2134 15.2131L1.07125 1.071" stroke="#0D2244"/>
          </svg>
        </button>
      </div>

      {% comment %}
        --- Optional top progress slider (keep for easy restore) ---
        Uncomment this block, then in assets/section-quiz.css remove only the
        `display: none;` line inside `.quiz__progress { ... }`. Optionally add
        `.quiz__content-headline { display: none; }` to hide step titles while
        using the slider. quiz.js already wires [data-quiz-progress] when present.

        {%- assign quiz_total_steps = 6 -%}
        <div class="quiz__progress page-width" data-quiz-progress data-total-steps="{{ quiz_total_steps }}">
          <div class="quiz__progress-track">
            <div class="quiz__progress-fill" data-quiz-progress-fill style="width: 0%;"></div>
          </div>
          <div class="quiz__progress-labels">
            {%- for i in (1..quiz_total_steps) -%}
              <span class="quiz__progress-label" data-step="{{ i }}">{{ i }}</span>
            {%- endfor -%}
          </div>
        </div>
      {% endcomment %}

      <div class="quiz__content page-width">
        <div class="quiz__content-headline">
          {%- assign headline_step = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'step' -%}
              {%- assign headline_step = headline_step | plus: 1 -%}
              {%- assign quiz_headline = block.settings.headline | replace: '{', "<span class='stylized'>" | replace: '}', '</span>' -%}
              <h3 class="quiz__headline{% if headline_step == 1 %} active{% endif %}" data-step="{{ headline_step }}">{{ quiz_headline }}</h3>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="quiz__content-card">
          <div
            class="quiz__final-loading-overlay"
            data-quiz-final-overlay
            aria-hidden="true"
          >
            <div class="quiz__final-loading-overlay__stack">
              <div class="quiz__final-loading-overlay__spinner" aria-hidden="true">
                <svg viewBox="0 0 50 50" class="quiz__final-loading-overlay__svg">
                  <circle class="quiz__final-loading-overlay__track" cx="25" cy="25" r="20" fill="none" stroke-width="4"></circle>
                  <circle
                    class="quiz__final-loading-overlay__fill"
                    cx="25"
                    cy="25"
                    r="20"
                    fill="none"
                    stroke-width="4"
                    data-quiz-final-spinner-fill
                  ></circle>
                </svg>
              </div>
              <p class="quiz__final-loading-overlay__caption">Building your formula</p>
            </div>
          </div>
          <div class="quiz__form">
            {% form 'customer' %}
              {%- liquid
                assign step_n = 0
                assign open_step = false
                assign open_options = false
                assign open_text = false
                assign q_name = ''
                assign q_type = 'radio'
                assign q_layout = 'stack'
              -%}

              {%- for block in section.blocks -%}
                {%- case block.type -%}

                  {%- when 'step' -%}
                    {%- if open_options %}</fieldset></div>{% assign open_options = false %}{% endif -%}
                    {%- if open_text %}</div>{% assign open_text = false %}{% endif -%}
                    {%- if open_step %}</div>{% endif -%}
                    {%- assign step_n = step_n | plus: 1 -%}
                    <div class="form__step-wrapper{% if step_n == 1 %} active{% endif %}" data-step="{{ step_n }}" {{ block.shopify_attributes }}>
                    {%- assign open_step = true -%}

                  {%- when 'question' -%}
                    {%- if open_options %}</fieldset></div>{% assign open_options = false %}{% endif -%}
                    {%- if open_text %}</div>{% assign open_text = false %}{% endif -%}
                    {%- liquid
                      assign q_name = block.settings.name
                      assign q_type = block.settings.input_type
                      assign q_layout = block.settings.layout
                    -%}
                    {%- comment -%}
                      A picture on an option is the instruction. No other
                      layout can draw one, so rather than ignore it and leave
                      the merchant wondering, look ahead at this question's
                      options and switch to cards if any carry an image.
                    {%- endcomment -%}
                    {%- assign scan_from = forloop.index -%}
                    {%- for later in section.blocks offset: scan_from -%}
                      {%- if later.type != 'option' -%}{%- break -%}{%- endif -%}
                      {%- if later.settings.image != blank -%}
                        {%- assign q_layout = 'cards' -%}
                        {%- break -%}
                      {%- endif -%}
                    {%- endfor -%}
                    <div class="quiz__question" {{ block.shopify_attributes }}>
                      {%- if block.settings.heading != blank -%}
                        <p class="h5">{{ block.settings.heading }}</p>
                      {%- endif -%}
                      {%- if block.settings.subheading != blank -%}
                        <p class="body-sm">{{ block.settings.subheading }}</p>
                      {%- endif -%}
                      {%- if block.settings.image != blank -%}
                        <div class="quiz__question-figure">
                          <img
                            src="{{ block.settings.image | image_url: width: 600 }}"
                            alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
                            loading="lazy"
                          >
                        </div>
                      {%- endif -%}
                    </div>
                    <div class="quiz__input-group{% if q_layout == 'columns' %} quiz__input-group-columns{% endif %}">
                    <fieldset class="{% if q_layout == 'row' %}fieldset-row{% elsif q_layout == 'columns' %}fieldset-columns{% elsif q_layout == 'cards' %}fieldset-cards{% endif %}">
                    {%- assign open_options = true -%}

                  {%- when 'option' -%}
                    {%- liquid
                      assign opt_value = block.settings.value | default: block.settings.label
                      assign opt_id = q_name | append: '_' | append: opt_value | handle
                    -%}
                    {%- if q_layout == 'cards' -%}
                      <label class="quiz__card" for="{{ opt_id }}" {{ block.shopify_attributes }}>
                        <input class="for_email_klaviyo" type="{{ q_type }}" id="{{ opt_id }}" name="{{ q_name }}" value="{{ opt_value | escape }}">
                        <span class="quiz__card-photo">
                          {%- if block.settings.image != blank -%}
                            <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.image.alt | default: block.settings.label | escape }}" loading="lazy">
                          {%- endif -%}
                        </span>
                        <span class="quiz__card-foot">
                          <span class="quiz__card-tick" aria-hidden="true"></span>
                          <span class="quiz__card-text">{{ block.settings.label }}</span>
                        </span>
                      </label>
                    {%- else -%}
                      <label for="{{ opt_id }}" {{ block.shopify_attributes }}>
                        <input class="for_email_klaviyo" type="{{ q_type }}" id="{{ opt_id }}" name="{{ q_name }}" value="{{ opt_value | escape }}">
                        <div class="custom-radio-button"></div>
                        {{ block.settings.label }}
                      </label>
                    {%- endif -%}

                  {%- when 'text_input' -%}
                    {%- if open_options %}</fieldset></div>{% assign open_options = false %}{% endif -%}
                    {%- if block.settings.label != blank -%}
                      {%- if open_text %}</div>{% assign open_text = false %}{% endif -%}
                      <label class="{% if block.settings.label_hidden %}visually-hidden{% else %}h5{% endif %}" for="{{ block.settings.name }}">{{ block.settings.label }}</label>
                    {%- endif -%}
                    {%- unless open_text -%}
                      <div class="quiz__input-group quiz__input-group-columns">
                      {%- assign open_text = true -%}
                    {%- endunless -%}
                    <input
                      type="text"
                      id="{{ block.settings.name }}"
                      name="{{ block.settings.name }}"
                      placeholder="{{ block.settings.placeholder }}"
                      {{ block.shopify_attributes }}
                      {% if block.settings.required %}required{% endif %}
                    >

                  {%- when 'snippet' -%}
                    {%- if open_options %}</fieldset></div>{% assign open_options = false %}{% endif -%}
                    {%- if open_text %}</div>{% assign open_text = false %}{% endif -%}
                    {%- comment -%} render needs a literal name, so the choices are enumerated {%- endcomment -%}
                    {%- case block.settings.snippet -%}
                      {%- when 'shade_slider' -%}
                        {% render 'quiz-step-shade-slider' %}
                      {%- when 'final_report' -%}
                        {% render 'quiz-step-five' %}
                    {%- endcase -%}

                {%- endcase -%}
              {%- endfor -%}

              {%- if open_options %}</fieldset></div>{% endif -%}
              {%- if open_text %}</div>{% endif -%}
              {%- if open_step %}</div>{% endif -%}

              {%- comment -%}
                Safety net: a static section's blocks live in settings_data.json,
                not in a preset, so a theme pushed without them would otherwise
                render an empty quiz on a live revenue path.
              {%- endcomment -%}
              {%- if section.blocks.size == 0 -%}
                <div class="form__step-wrapper active" data-step="1">{% render 'quiz-step-one' %}</div>
                <div class="form__step-wrapper" data-step="2">{% render 'quiz-step-two' %}</div>
                <div class="form__step-wrapper" data-step="3">{% render 'quiz-step-shade-slider' %}</div>
                <div class="form__step-wrapper" data-step="4">{% render 'quiz-step-three' %}</div>
                <div class="form__step-wrapper" data-step="5">{% render 'quiz-step-four' %}</div>
                <div class="form__step-wrapper" data-step="6">{% render 'quiz-step-five' %}</div>
              {%- endif -%}
            {% endform %}

            <div class="quiz__content-buttons">
              <button class="text-link" data-form-back>Back</button>
              <button class="button" data-form-next disabled>Continue</button>
              <button class="button hidden" data-form-submit>
                <span class="button-text">See Your Results</span>
                <div class="loading-overlay__spinner">
                  <svg
                    aria-hidden="true"
                    focusable="false"
                    role="presentation"
                    class="spinner"
                    viewBox="0 0 66 66"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <circle class="path" fill="none" stroke-width="6" style="stroke: #FFFFFF!important;" cx="33" cy="33" r="30"></circle>
                  </svg>
                </div>
              </button>
            </div>
          </div>
        </div>
      </div>
      <div class="quiz__footer">
        <div class="quiz__footer-links">
          {% if section.settings.footer != blank %}
            <ul class="footer__menu list-unstyled">
              {% for link in section.settings.footer.links %}
                <li>
                  <a
                    href="{{ link.url }}"
                    class="footer__menu-link"
                  >
                    {{ link.title }}
                  </a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>

        <div class="quiz__footer-copyright">
          <p class="footer__copy">
            &copy; {{ shop.name | link_to: routes.root_url }}
            {{ 'now' | date: '%Y' }}. All rights reserved.
          </p>
        </div>
      </div>
    </div>
  </section>
</formula-quiz>

{% comment %} Hidden Klaviyo form {% endcomment %}
<form
  style="display:none"
  id="email_signup"
  class="klaviyo_styling klaviyo_gdpr_embed_SDmCaY"
  action="//manage.kmail-lists.com/subscriptions/subscribe"
  data-ajax-submit="//manage.kmail-lists.com/ajax/subscriptions/subscribe"
  method="GET"
  target="_blank"
  novalidate="novalidate"
>
  <input type="hidden" name="g" value="SDmCaY">
  <input
    type="hidden"
    name="$fields"
    value="$consent,$sensitivity,$first_name,$last_name,$goals,$brush_times,$cavities,$plaque_concern,$shade,$stain,$previous_use"
  >
  <input
    type="hidden"
    name="$list_fields"
    value="$consent, sensitivity, $first_name, $last_name, goals, brush_times, cavities, plaque_concern, shade, stain, previous_use"
  >
  <div class="klaviyo_field_group">
    <label for="k_id_email">Newsletter Sign Up</label>
    <input class="" type="email" value="" name="email" id="k_id_email" placeholder="Your email">
    <label for="k_id_firstname">First_name</label>
    <input class="" type="text" value="" name="$first_name" id="k_id_firstname" placeholder="First name">
    <label for="k_id_lastname">Last Name</label>
    <input class="" type="text" value="" name="$last_name" id="k_id_lastname" placeholder="Last name">

    <label class="klaviyo_form_actions" for="klaviyo_form_goals">goals:</label>
    <input class="klaviyo_form_actions" id="klaviyo_form_goals" type="text" name="$goals" value="">

    <label class="klaviyo_form_actions" for="klaviyo_form_brush_times">brush times:</label>
    <input class="klaviyo_form_actions" id="klaviyo_form_brush_times" type="text" name="$brush_times" value="">

    <label class="klaviyo_form_actions" for="klaviyo_form_sensitivity">Sensitivity:</label>
    <input class="klaviyo_form_actions" id="klaviyo_form_sensitivity" type="text" name="$sensitivity" value="">

    <label class="klaviyo_form_actions" for="klaviyo_form_cavities">cavities:</label>
    <input class="klaviyo_form_actions" id="klaviyo_form_cavities" type="text" name="$cavities" value="">

    <label class="klaviyo_form_actions" for="klaviyo_form_plaque_concern">plaque concern:</label>
    <input class="klaviyo_form_actions" id="klaviyo_form_plaque_concern" type="text" name="$plaque_concern" value="">

    <label class="klaviyo_form_actions" for="klaviyo_form_shade">shade:</label>
    <input class="klaviyo_form_actions" id="klaviyo_form_shade" type="text" name="$shade" value="">

    <label class="klaviyo_form_actions" for="klaviyo_form_stain">stain:</label>
    <input class="klaviyo_form_actions" id="klaviyo_form_stain" type="text" name="$stain" value="">

    <label class="klaviyo_form_actions" for="klaviyo_form_previous_use">previous_use:</label>
    <input class="klaviyo_form_actions" id="klaviyo_form_previous_use" type="text" name="$previous_use" value="">

    <div class="klaviyo_field_group klaviyo_form_actions">
      <div class="klaviyo_helptext">How would you like to hear from us? (please select at least one option)</div>
      <input type="checkbox" name="$consent" id="consent-email" value="email" checked>
      <label for="consent-email">Email</label><br>
      <input type="checkbox" name="$consent" id="consent-web" value="web" checked>
      <label for="consent-web">Online advertisements</label>
    </div>
  </div>
  <div class="klaviyo_messages">
    <div class="success_message" style="display:none;"></div>
    <div class="error_message" style="display:none;"></div>
  </div>
  <div class="klaviyo_form_actions">
    <button style="display: none !important" type="submit" class="klaviyo_submit_button">Subscribe</button>
  </div>
</form>
<script type="text/javascript" src="//www.klaviyo.com/media/js/public/klaviyo_subscribe.js"></script>
<script type="text/javascript">
  try {
    KlaviyoSubscribe.attachToForms('#email_signup', {
      hide_form_on_success: true,
      extra_properties: {
        $source: '$embed',
        $method_type: 'Klaviyo Form',
        $method_id: 'embed',
        $consent_version: 'Embed default text',
      },
    });
  }
  catch(err) {
    console.log("klaviyo errors")
    console.log(err)
  }
</script>

{% schema %}
{
  "name": "Quiz",
  "settings": [
    {
      "type": "textarea",
      "id": "quiz_svg_logo",
      "label": "SVG Logo"
    },
    {
      "type": "link_list",
      "id": "footer",
      "label": "Footer links"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "textarea",
          "id": "headline",
          "label": "Headline",
          "default": "Closer to Your Personalized Formula",
          "info": "Shown above the card. Wrap stylized text in {}"
        },
        {
          "type": "paragraph",
          "content": "Everything after this block, until the next Step, appears on this screen."
        }
      ]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Question",
          "default": "How sensitive are your teeth?"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Helper line",
          "info": "Optional, e.g. Select all that apply."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Reference image",
          "info": "Optional, shown above the answers."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "sensitivity",
          "info": "The answer's key. quiz.js and Klaviyo read answers by this, so changing it detaches the question from the formula."
        },
        {
          "type": "select",
          "id": "input_type",
          "label": "How many answers",
          "default": "radio",
          "options": [
            {
              "value": "radio",
              "label": "One answer only"
            },
            {
              "value": "checkbox",
              "label": "Multiple answers"
            }
          ],
          "info": "Multiple answers draws square checkboxes; one answer draws round radios."
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Layout",
          "default": "stack",
          "options": [
            {
              "value": "stack",
              "label": "List"
            },
            {
              "value": "row",
              "label": "Row"
            },
            {
              "value": "columns",
              "label": "Two columns"
            },
            {
              "value": "cards",
              "label": "Picture cards"
            }
          ],
          "info": "Picture cards is used automatically as soon as any option has a picture."
        },
        {
          "type": "paragraph",
          "content": "Add Option blocks under this question. Picture cards show each option's image."
        }
      ]
    },
    {
      "type": "option",
      "name": "Option",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Mild"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "info": "What gets submitted. Leave blank to use the label."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Picture",
          "info": "Used when the question's layout is Picture cards."
        }
      ]
    },
    {
      "type": "text_input",
      "name": "Text field",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "What's your name?"
        },
        {
          "type": "checkbox",
          "id": "label_hidden",
          "label": "Hide the label visually",
          "default": false
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "first_name",
          "info": "Also the field's id. quiz.js reads #first_name, #last_name."
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Placeholder",
          "default": "First Name"
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "Required",
          "default": true
        },
        {
          "type": "paragraph",
          "content": "Consecutive text fields sit side by side on one row."
        }
      ]
    },
    {
      "type": "snippet",
      "name": "Built-in screen",
      "settings": [
        {
          "type": "select",
          "id": "snippet",
          "label": "Screen",
          "default": "shade_slider",
          "options": [
            {
              "value": "shade_slider",
              "label": "Shade sliders"
            },
            {
              "value": "final_report",
              "label": "Final report and email"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": "These two screens are built in code rather than from questions."
        }
      ]
    }
  ]
}
{% endschema %}

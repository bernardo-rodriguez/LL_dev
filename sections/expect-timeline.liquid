{%- comment -%}
  "What consistent use looks like." on the v2 artboard: a timeline. A navy
  disc with a white tick marks each stage and a hairline runs down to the
  next one; the stage is labelled in mono blue above its sentence.

  The what-to-expect section it replaces draws the same four stages inside a
  rounded pale card with carousel arrows and emoji, which belongs to the
  personalized page.
{%- endcomment -%}

{{ 'section-expect-timeline.css' | asset_url | stylesheet_tag }}

<div class="expect-timeline">
  <div class="expect-timeline__inner">
    <div class="expect-timeline__head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="expect-timeline__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="expect-timeline__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ol class="expect-timeline__list list-unstyled">
        {%- for block in section.blocks -%}
          <li class="expect-timeline__row{% if forloop.last %} expect-timeline__row--last{% endif %}" {{ block.shopify_attributes }}>
            <span class="expect-timeline__marker">
              <span class="expect-timeline__disc">
                <svg viewBox="0 0 14 14" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 7.5l3.5 3.5L12 3.5"/></svg>
              </span>
              {%- unless forloop.last -%}
                <span class="expect-timeline__line"></span>
              {%- endunless -%}
            </span>
            <span class="expect-timeline__copy">
              <span class="expect-timeline__label">{{ block.settings.label }}</span>
              <span class="expect-timeline__text">{{ block.settings.text }}</span>
            </span>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Expect timeline",
  "tag": "section",
  "class": "section-expect-timeline",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What to expect" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What consistent use looks like." }
  ],
  "blocks": [
    {
      "type": "stage",
      "name": "Stage",
      "settings": [
        { "type": "text", "id": "label", "label": "Stage", "default": "First treatment" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Expect timeline",
      "blocks": [{ "type": "stage" }, { "type": "stage" }, { "type": "stage" }, { "type": "stage" }]
    }
  ]
}
{% endschema %}

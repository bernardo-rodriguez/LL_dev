{{ 'section-personalized-offer.css' | asset_url | stylesheet_tag }}
{{ 'component-section-step.css' | asset_url | stylesheet_tag }}

{% assign steps = section.blocks | where: 'type', 'step' %}

<section
  class="personalized-offer {% if section.settings.margin_bottom %}personalized-offer--with-spacing{% endif %}"
  data-section-id="{{ section.id }}"
  {% if section.settings.flow_visibility == 'quiz' %}data-ll-only="quiz"{% elsif section.settings.flow_visibility == 'direct' %}data-ll-only="direct"{% endif %}
>
  <div class="page-width">
    <div class="personalized-offer__inner">

      {% if section.settings.button_label != blank %}
        <a
          class="personalized-offer__cta personalized-offer__cta--top"
          {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}href="#"{% endif %}
          {% if section.settings.button_opens_quiz %}data-open-quiz{% endif %}
        >{{ section.settings.button_label }}</a>
      {% endif %}

      <div class="personalized-offer__header">
        {% if section.settings.eyebrow != blank or section.settings.step_number != blank %}
          {% render 'section-step', number: section.settings.step_number, label: section.settings.eyebrow %}
        {% endif %}
        {% if section.settings.heading != blank %}
          <h3 class="section-heading personalized-offer__heading">{{ section.settings.heading }}</h3>
        {% endif %}
        {% if section.settings.body != blank %}
          <p class="personalized-offer__body body-md">{{ section.settings.body }}</p>
        {% endif %}
      </div>

      <div class="personalized-offer__media">
        {% if section.settings.image != blank %}
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 769px) 50vw, 100vw"
            alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
            loading="lazy"
          >
        {% endif %}
        {% if section.settings.media_chip != blank %}
          <span class="personalized-offer__chip">
            {{ section.settings.media_chip }}
            {% assign chip_dots = section.settings.media_chip_colours | default: '' | split: ',' %}
            {% for dot in chip_dots %}
              <span class="personalized-offer__chip-dot" style="background: {{ dot | strip }}" aria-hidden="true"></span>
            {% endfor %}
          </span>
        {% endif %}
        {% if section.settings.badge != blank %}
          <span class="personalized-offer__badge label-sm">{{ section.settings.badge }}</span>
        {% endif %}
      </div>

      <div class="personalized-offer__detail">
        {% if section.settings.trust != blank %}
          <p class="personalized-offer__trust">{{ section.settings.trust }}</p>
        {% endif %}

        <div class="personalized-offer__pricing">
          <p class="personalized-offer__price">
            <span class="personalized-offer__price-now">{{ section.settings.price }}</span>
            {% if section.settings.price_was != blank %}
              <span class="personalized-offer__price-was">{{ section.settings.price_was }}</span>
            {% endif %}
          </p>
          {% if section.settings.price_note != blank %}
            <p class="personalized-offer__price-note">{{ section.settings.price_note }}</p>
          {% endif %}
        </div>

        {% if steps.size > 0 %}
          <ul class="personalized-offer__includes-list list-unstyled">
            {% for block in steps %}
              <li class="personalized-offer__include" {{ block.shopify_attributes }}>
                <span class="personalized-offer__include-icon" aria-hidden="true">
                  {% case block.settings.icon %}
                    {% when 'mouthpiece' %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M4 11c0-3 3.6-5 8-5s8 2 8 5v2c0 2-2 3-4 3H8c-2 0-4-1-4-3z"/><path d="M12 2v2M5 4l1.2 1.2M19 4l-1.2 1.2"/></svg>
                    {% when 'shipping' %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M2 6h11v10H2z"/><path d="M13 9h4l3 3v4h-7"/><circle cx="6" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>
                    {% else %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M9 3h6v3l1.5 2v12a1 1 0 0 1-1 1h-7a1 1 0 0 1-1-1V8L9 6z"/><path d="M9 6h6"/><path d="M7.5 12h9"/></svg>
                  {% endcase %}
                </span>
                <span class="personalized-offer__include-text">{{ block.settings.text }}{% if block.settings.suffix != blank %} <span class="personalized-offer__include-suffix">{{ block.settings.suffix }}</span>{% endif %}</span>
              </li>
            {% endfor %}
          </ul>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <a
            class="personalized-offer__cta"
            {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}href="#"{% endif %}
            {% if section.settings.button_opens_quiz %}data-open-quiz{% endif %}
          >{{ section.settings.button_label }}</a>
        {% endif %}

        {% if section.settings.guarantee != blank %}
          <p class="personalized-offer__guarantee">
            <span class="personalized-offer__guarantee-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M12 3 L19 6 V11 C19 16 16 19.5 12 21 C8 19.5 5 16 5 11 V6 Z"/><path d="M9 12 l2 2 l4 -4"/></svg>
            </span>
            {{ section.settings.guarantee }}
          </p>
        {% endif %}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Personalized Offer",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product image"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge over the image",
      "default": "Anniversary sale 40% off"
    },
    {
      "type": "text",
      "id": "media_chip",
      "label": "Chip over the image",
      "default": "Blended for your causes"
    },
    {
      "type": "text",
      "id": "media_chip_colours",
      "label": "Chip dots",
      "default": "#A87B2A, #8A5A3C, #73476E, #4F7A91",
      "info": "Comma separated colours, one dot each."
    },
    {
      "type": "text",
      "id": "step_number",
      "label": "Step number",
      "default": "3"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Shipped to your door"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Your formula, in one simple starter kit."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body copy",
      "default": "Everything you need to start. Nothing else to buy."
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "default": "$39"
    },
    {
      "type": "text",
      "id": "price_was",
      "label": "Price before discount",
      "default": "$65"
    },
    {
      "type": "text",
      "id": "price_note",
      "label": "Line under the price",
      "default": "vs. $500 for personalized whitening at the dentist"
    },
    {
      "type": "text",
      "id": "includes",
      "label": "What the kit includes",
      "default": "Includes Blue LED mouthpiece and 3 custom gels"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Build my formula"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "button_opens_quiz",
      "label": "Button opens the quiz",
      "default": true
    },
    {
      "type": "text",
      "id": "guarantee",
      "label": "Guarantee line",
      "default": "Noticeably whiter in 30 days or your money back"
    },
    {
      "type": "text",
      "id": "trust",
      "label": "Trust line",
      "default": "Enamel-safe · Dentist-formulated · FDA-registered"
    },
    {
      "type": "text",
      "id": "shipping",
      "label": "Shipping line",
      "default": "Free shipping"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "margin_bottom",
      "label": "Extra space below",
      "default": false,
      "info": "Off by default. Sections carry their spacing on top, so the next one supplies the gap."
    },
    {
      "type": "header",
      "content": "Personalization flow"
    },
    {
      "type": "select",
      "id": "flow_visibility",
      "label": "Show this section to",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "Everyone"
        },
        {
          "value": "quiz",
          "label": "Quiz arrivals only"
        },
        {
          "value": "direct",
          "label": "Direct arrivals only"
        }
      ],
      "info": "Preview either flow by adding ?ll_flow=quiz or ?ll_flow=direct to the page URL."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Included",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Item",
          "default": "Your custom formula gel"
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "Muted suffix",
          "info": "Optional, e.g. · 6 treatments"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "gel",
          "options": [
            {
              "value": "gel",
              "label": "Gel"
            },
            {
              "value": "mouthpiece",
              "label": "Mouthpiece"
            },
            {
              "value": "shipping",
              "label": "Shipping"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Personalized Offer",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "text": "Take the 2-min quiz"
          }
        },
        {
          "type": "step",
          "settings": {
            "text": "Get a formula made for your smile"
          }
        },
        {
          "type": "step",
          "settings": {
            "text": "Avg. 7 shades whiter in 6 days (20 min daily)"
          }
        }
      ]
    }
  ]
}
{% endschema %}

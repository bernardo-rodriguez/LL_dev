          "settings": {
            "heading": "Sample benefit",
            "title": "Benefit title",
            "text": "Add more cards in the theme editor."
          }
        }
      ]
    },
    {
      "name": "Key Benefits (list)",
      "settings": {
        "layout": "list",
        "heading": "Key Benefits"
      },
      "blocks": [
        {
          "type": "list_item",
          "settings": {
            "title": "Stronger & Quicker Than Generic",
            "description": "Insert description"
          }
        },
        {
          "type": "list_item",
          "settings": {
            "title": "Long-Lasting Results",
            "description": "Insert description"
          }
        },
        {
          "type": "list_item",
          "settings": {
            "title": "Clinically Trialed. Zero Gimmicks",
            "description": "Insert description"
          }
        },
        {
          "type": "list_item",
          "settings": {
            "title": "Used By Dentists Themselves",
            "description": "Insert description"
          }
        },
        {
          "type": "list_item",
          "settings": {
            "title": "Professional Whitening At Drugstore Prices",
            "description": "Insert description"
          }
        }
      ]
    }
  ]
}
{% endschema %}
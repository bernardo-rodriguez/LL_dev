    {
      "type": "checkbox",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "default": true
    }
  ],
  "blocks": [
    {
      "name": "Card",
      "type": "card",
      "settings": [
        {
          "type": "textarea",
          "id": "heading",
          "label": "Ingredient"
        },
        {
          "type": "textarea",
          "id": "title",
          "label": "Benefit",
          "info": "Will display as italized text"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "name": "List item",
      "type": "list_item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon / Image",
          "info": "Leave empty for light blue circle"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Benefit title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Insert description"

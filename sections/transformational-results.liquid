{{ 'section-transformational-results.css' | asset_url | stylesheet_tag }}
{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>

<section class="transformational-results" data-section-id="{{ section.id }}">
  <div class="page-width {% if template == 'product' %}page-width--product{% endif %}">
    <div class="transformational-results__inner">
      <div class="transformational-results__slider-column">
        <h2 class="transformational-results__heading">{{ section.settings.heading | default: 'Transformational Results' }}</h2>

        <div class="transformational-results__tabs" role="tablist">
          <button type="button" class="transformational-results__tab active" data-duration="2" aria-selected="true">2 MONTHS</button>
          <button type="button" class="transformational-results__tab" data-duration="4" aria-selected="false">4 MONTHS</button>
          <button type="button" class="transformational-results__tab" data-duration="6" aria-selected="false">6 MONTHS</button>
        </div>

        <div class="transformational-results__swiper-wrap">
          <div class="transformational-results__swiper swiper" id="transformationalResultsSwiper-{{ section.id }}">
            <div class="swiper-wrapper">
              {% assign profile_blocks = section.blocks | where: 'type', 'profile' %}
              {% for block in profile_blocks %}
                <div class="swiper-slide transformational-results__slide" {{ block.shopify_attributes }}
                  data-month-2="{{ block.settings.image_month_2 | image_url: width: 600 }}"
                  data-month-4="{{ block.settings.image_month_4 | image_url: width: 600 }}"
                  data-month-6="{{ block.settings.image_month_6 | image_url: width: 600 }}">
                  <div class="transformational-results__images">
                    <div class="transformational-results__image-wrap">
                      {% if block.settings.image_month_0 != blank %}
                        <img
                          src="{{ block.settings.image_month_0 | image_url: width: 600 }}"
                          alt="Month 0"
                          class="transformational-results__image transformational-results__image--before"
                          loading="lazy"
                          width="300"
                          height="300"
                        >
                      {% endif %}
                      <span class="transformational-results__image-label">MONTH 0</span>
                    </div>
                    <div class="transformational-results__image-wrap">
                      {% assign after_img = block.settings.image_month_6 | default: block.settings.image_month_4 | default: block.settings.image_month_2 %}
                      {% if after_img != blank %}
                        <img
                          src="{{ after_img | image_url: width: 600 }}"
                          alt="Month 6"
                          class="transformational-results__image transformational-results__image--after"
                          loading="lazy"
                          width="300"
                          height="300"
                          data-src-2="{% if block.settings.image_month_2 != blank %}{{ block.settings.image_month_2 | image_url: width: 600 }}{% endif %}"
                          data-src-4="{% if block.settings.image_month_4 != blank %}{{ block.settings.image_month_4 | image_url: width: 600 }}{% endif %}"
                          data-src-6="{% if block.settings.image_month_6 != blank %}{{ block.settings.image_month_6 | image_url: width: 600 }}{% endif %}"
                        >
                      {% endif %}
                      <span class="transformational-results__image-label transformational-results__image-label--after">MONTH <span class="transformational-results__month-num">6</span></span>
                    </div>
                  </div>
                  {% if block.settings.person_name != blank %}
                    <p class="transformational-results__name">{{ block.settings.person_name }}</p>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          </div>
          <div class="swiper-button-prev transformational-results__button-prev"></div>
          <div class="swiper-button-next transformational-results__button-next"></div>
        </div>
      </div>

      <div class="transformational-results__stats-column">
        {% assign stat_blocks = section.blocks | where: 'type', 'stat' %}
        {% for block in stat_blocks %}
          <div class="transformational-results__stat" {{ block.shopify_attributes }}>
            <span class="transformational-results__stat-percent">{{ block.settings.percent }}</span>
            <p class="transformational-results__stat-text">{{ block.settings.text }}</p>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionId = document.querySelector('.transformational-results')?.dataset?.sectionId;
    if (!sectionId) return;

    const swiperEl = document.getElementById('transformationalResultsSwiper-' + sectionId);
    if (!swiperEl) return;
    if (swiperEl.swiper) return;

    const section = swiperEl.closest('.transformational-results');

    const tabs = document.querySelectorAll('.transformational-results__tab');
    let currentDuration = 6;

    function setAfterImage(slideEl, duration) {
      const afterImg = slideEl?.querySelector('.transformational-results__image--after');
      const labelNum = slideEl?.querySelector('.transformational-results__month-num');
      if (!afterImg) return;
      const src = afterImg.getAttribute('data-src-' + duration);
      if (src) {
        afterImg.src = src;
        afterImg.alt = 'Month ' + duration;
      }
      if (labelNum) labelNum.textContent = duration;
    }

    function updateAllAfterImages() {
      swiperEl.querySelectorAll('.transformational-results__slide').forEach(function(slide) {
        setAfterImage(slide, currentDuration);
      });
    }

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        const duration = parseInt(this.dataset.duration, 10);
        currentDuration = duration;
        tabs.forEach(function(t) {
          t.classList.toggle('active', parseInt(t.dataset.duration, 10) === duration);
          t.setAttribute('aria-selected', t.classList.contains('active'));
        });
        updateAllAfterImages();
      });
    });

    const profileCount = swiperEl.querySelectorAll('.swiper-slide').length;
    const transformationalSwiper = new Swiper(swiperEl, {
      slidesPerView: 1,
      spaceBetween: 20,
      loop: profileCount > 1,
      zoom: false,
      touchRatio: 1,
      allowTouchMove: true,
      navigation: {
        nextEl: swiperEl.closest('.transformational-results__swiper-wrap').querySelector('.transformational-results__button-next'),
        prevEl: swiperEl.closest('.transformational-results__swiper-wrap').querySelector('.transformational-results__button-prev'),
      },
      on: {
        init: function() {
          updateAllAfterImages();
        }
      }
    });

    var wrap = swiperEl.closest('.transformational-results__swiper-wrap');
    var prevBtn = wrap.querySelector('.transformational-results__button-prev');
    var nextBtn = wrap.querySelector('.transformational-results__button-next');
    if (profileCount <= 1) {
      if (prevBtn) prevBtn.style.display = 'none';
      if (nextBtn) nextBtn.style.display = 'none';
    }
  });
</script>

{% schema %}
{
  "name": "Transformational Results",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Transformational Results"
    }
  ],
  "blocks": [
    {
      "type": "profile",
      "name": "Person profile",
      "settings": [
        {
          "type": "text",
          "id": "person_name",
          "label": "Name",
          "default": "NEELAM S."
        },
        {
          "type": "image_picker",
          "id": "image_month_0",
          "label": "Image – Month 0 (before)"
        },
        {
          "type": "image_picker",
          "id": "image_month_2",
          "label": "Image – Month 2"
        },
        {
          "type": "image_picker",
          "id": "image_month_4",
          "label": "Image – Month 4"
        },
        {
          "type": "image_picker",
          "id": "image_month_6",
          "label": "Image – Month 6"
        }
      ]
    },
    {
      "type": "stat",
      "name": "Statistic",
      "settings": [
        {
          "type": "text",
          "id": "percent",
          "label": "Percentage",
          "default": "100%"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "100% of clinical participants reported whiter teeth after only 6 treatments."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Transformational Results",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "percent": "100%",
            "text": "100% of clinical participants reported whiter teeth after only 6 treatments."
          }
        },
        {
          "type": "stat",
          "settings": {
            "percent": "74%",
            "text": "Clinical participants reported, on average, a 74% increase in teeth brightness."
          }
        },
        {
          "type": "stat",
          "settings": {
            "percent": "0%",
            "text": "0% of clinical participants reported an increase in sensitivity after whitening."
          }
        },
        {
          "type": "profile",
          "settings": {
            "person_name": "NEELAM S."
          }
        }
      ]
    }
  ]
}
{% endschema %}

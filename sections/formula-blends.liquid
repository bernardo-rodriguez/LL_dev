{{ 'section-formula-blends.css' | asset_url | stylesheet_tag }}

{% assign formatted_heading = section.settings.heading
  | replace: '{', "<span class='stylized'>"
  | replace: '}', '</span>'
%}

{% assign blend_blocks = section.blocks | where: 'type', 'blend' %}
{% assign trust_blocks = section.blocks | where: 'type', 'trust' %}

<section
  class="formula-blends {% if section.settings.margin_bottom %}formula-blends--with-spacing{% endif %}"
  data-section-id="{{ section.id }}"
>
  <div class="page-width {% if template == 'product' %}page-width--product{% endif %}">
    <div class="formula-blends__inner">
      <div class="formula-blends__columns">
        {%- comment -%} Left rail: eyebrow, heading, image. Sticky on desktop. {%- endcomment -%}
        <div class="formula-blends__rail">
          {% if section.settings.eyebrow != blank %}
            <p class="formula-blends__eyebrow label-sm">{{ section.settings.eyebrow }}</p>
          {% endif %}

          {% if section.settings.heading != blank %}
            <h3 class="formula-blends__heading">{{ formatted_heading }}</h3>
          {% endif %}

          {% if section.settings.image != blank %}
            <div class="formula-blends__image {% unless section.settings.show_image_mobile %}formula-blends__image--desktop-only{% endunless %}">
              <img
                src="{{ section.settings.image | image_url: width: 800 }}"
                srcset="
                  {{ section.settings.image | image_url: width: 400 }} 400w,
                  {{ section.settings.image | image_url: width: 800 }} 800w,
                  {{ section.settings.image | image_url: width: 1200 }} 1200w
                "
                sizes="(min-width: 769px) 50vw, 100vw"
                alt="{{ section.settings.image.alt | default: section.settings.heading | strip_html | escape }}"
                width="{{ section.settings.image.width }}"
                height="{{ section.settings.image.height }}"
                loading="lazy"
              >
            </div>
          {% endif %}
        </div>

        {%- comment -%} Right column: intro, blend accordion, trust markers, footnote {%- endcomment -%}
        <div class="formula-blends__main">
          {% if section.settings.intro != blank %}
            <p class="formula-blends__intro sh2">{{ section.settings.intro }}</p>
          {% endif %}

          {% if blend_blocks.size > 0 %}
            <div class="formula-blends__list">
              {%- comment -%}
                Blocks are flat in Shopify, so ingredients are grouped by position:
                each "ingredient" block belongs to the "blend" block above it.
              {%- endcomment -%}
              {% assign blend_index = 0 %}
              {% for block in section.blocks %}
                {% if block.type != 'blend' %}
                  {% continue %}
                {% endif %}
                {% assign blend_index = blend_index | plus: 1 %}

                {%- comment -%}
                  Capture the outer loop position BEFORE the nested loop — inside and
                  after a nested for, `forloop` refers to the inner loop.
                {%- endcomment -%}
                {% assign ingredients_start = forloop.index %}

                {%- comment -%} Count the ingredient blocks that directly follow this blend {%- endcomment -%}
                {% assign ingredient_count = 0 %}
                {% for ing in section.blocks offset: ingredients_start %}
                  {% unless ing.type == 'ingredient' %}
                    {% break %}
                  {% endunless %}
                  {% assign ingredient_count = ingredient_count | plus: 1 %}
                {% endfor %}

                {% assign is_open = false %}
                {% if section.settings.first_open and blend_index == 1 %}
                  {% assign is_open = true %}
                {% endif %}
                {% assign panel_id = 'FormulaBlend-' | append: section.id | append: '-' | append: block.id %}

                <div class="formula-blends__item {% if is_open %}formula-blends__item--open{% endif %}" {{ block.shopify_attributes }}>
                  <button
                    type="button"
                    class="formula-blends__item-header"
                    aria-expanded="{% if is_open %}true{% else %}false{% endif %}"
                    aria-controls="{{ panel_id }}"
                  >
                    <span class="formula-blends__item-number label-sm">
                      {{ blend_index | prepend: '0' | slice: -2, 2 }}
                    </span>
                    <span class="formula-blends__item-titles">
                      {% if block.settings.name != blank %}
                        <span class="formula-blends__item-name">{{ block.settings.name }}</span>
                      {% endif %}
                      {% if block.settings.summary != blank %}
                        <span class="formula-blends__item-summary stylized">{{ block.settings.summary }}</span>
                      {% endif %}
                    </span>
                    <span class="formula-blends__item-toggle" aria-hidden="true"></span>
                  </button>

                  {% if ingredient_count > 0 or block.settings.ingredients != blank %}
                    <div class="formula-blends__item-panel" id="{{ panel_id }}" {% unless is_open %}hidden{% endunless %}>
                      <div class="formula-blends__ingredients">
                        {% if ingredient_count > 0 %}
                          {%- comment -%} Ingredient blocks: individually editable, each with its own image {%- endcomment -%}
                          {% for ing in section.blocks offset: ingredients_start limit: ingredient_count %}
                            <div class="formula-blends__ingredient" {{ ing.shopify_attributes }}>
                              <span class="formula-blends__ingredient-media">
                                {% if ing.settings.image != blank %}
                                  <img
                                    src="{{ ing.settings.image | image_url: width: 320 }}"
                                    srcset="
                                      {{ ing.settings.image | image_url: width: 224 }} 224w,
                                      {{ ing.settings.image | image_url: width: 320 }} 320w
                                    "
                                    sizes="(min-width: 769px) 112px, 100px"
                                    alt="{{ ing.settings.image.alt | default: ing.settings.name | escape }}"
                                    width="112"
                                    height="78"
                                    loading="lazy"
                                  >
                                {% endif %}
                              </span>
                              {% if ing.settings.name != blank %}
                                <span class="formula-blends__ingredient-name sh3">{{ ing.settings.name }}</span>
                              {% endif %}
                              {% if ing.settings.role != blank %}
                                <span class="formula-blends__ingredient-role stylized">{{ ing.settings.role }}</span>
                              {% endif %}
                            </div>
                          {% endfor %}
                        {% else %}
                          {%- comment -%}
                            Fallback for blends still using the "one per line" textarea.
                            Add Ingredient blocks under the blend to get per-ingredient images.
                          {%- endcomment -%}
                          {% assign ingredient_lines = block.settings.ingredients | newline_to_br | split: '<br />' %}
                          {% for line in ingredient_lines %}
                            {% assign trimmed = line | strip %}
                            {% if trimmed != blank %}
                              {% assign parts = trimmed | split: '|' %}
                              <div class="formula-blends__ingredient formula-blends__ingredient--no-media">
                                <span class="formula-blends__ingredient-name sh3">{{ parts[0] | strip }}</span>
                                {% if parts.size > 1 %}
                                  <span class="formula-blends__ingredient-role stylized">{{ parts[1] | strip }}</span>
                                {% endif %}
                              </div>
                            {% endif %}
                          {% endfor %}
                        {% endif %}
                      </div>
                    </div>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          {% endif %}

          {% if trust_blocks.size > 0 %}
            <div class="formula-blends__trust">
              {% for block in trust_blocks %}
                <div class="formula-blends__trust-item" {{ block.shopify_attributes }}>
                  <span class="formula-blends__trust-icon" aria-hidden="true">
                    {% if block.settings.icon != blank %}
                      <img
                        src="{{ block.settings.icon | image_url: width: 48 }}"
                        alt=""
                        width="20"
                        height="20"
                        loading="lazy"
                      >
                    {% else %}
                      &#10003;
                    {% endif %}
                  </span>
                  <span class="formula-blends__trust-text">
                    {% if block.settings.title != blank %}
                      <span class="formula-blends__trust-title label-sm">{{ block.settings.title }}</span>
                    {% endif %}
                    {% if block.settings.text != blank %}
                      <span class="formula-blends__trust-detail body-sm">{{ block.settings.text }}</span>
                    {% endif %}
                  </span>
                </div>
              {% endfor %}
            </div>
          {% endif %}

          {% if section.settings.footnote != blank %}
            <p class="formula-blends__footnote body-xs">{{ section.settings.footnote }}</p>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var section = document.querySelector('.formula-blends[data-section-id="{{ section.id }}"]');
    if (!section) return;

    var headers = section.querySelectorAll('.formula-blends__item-header');

    for (var i = 0; i < headers.length; i++) {
      headers[i].addEventListener('click', function () {
        var item = this.closest('.formula-blends__item');
        var panel = item.querySelector('.formula-blends__item-panel');
        var isOpen = item.classList.contains('formula-blends__item--open');

        {% if section.settings.close_others %}
          var openItems = section.querySelectorAll('.formula-blends__item--open');
          for (var j = 0; j < openItems.length; j++) {
            if (openItems[j] === item) continue;
            openItems[j].classList.remove('formula-blends__item--open');
            var openHeader = openItems[j].querySelector('.formula-blends__item-header');
            var openPanel = openItems[j].querySelector('.formula-blends__item-panel');
            if (openHeader) openHeader.setAttribute('aria-expanded', 'false');
            if (openPanel) openPanel.hidden = true;
          }
        {% endif %}

        item.classList.toggle('formula-blends__item--open', !isOpen);
        this.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
        if (panel) panel.hidden = isOpen;
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Formula Blends",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "What's Inside"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "An 11-ingredient formula for {your smile transformation*}",
      "info": "Wrap emphasized text in {} for the italic Canela style"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro paragraph",
      "default": "Four blends, each doing a specific job — and every formula is uniquely built to target your smile's needs."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "checkbox",
      "id": "show_image_mobile",
      "label": "Show image on mobile",
      "default": false
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Footnote",
      "default": "*Based on a clinical test of 34 participants using the kit 10 minutes daily, measured at 6 and 14 days."
    },
    {
      "type": "header",
      "content": "Accordion behaviour"
    },
    {
      "type": "checkbox",
      "id": "first_open",
      "label": "Open the first blend by default",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "close_others",
      "label": "Only one blend open at a time",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "blend",
      "name": "Blend",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Blend name",
          "default": "Sensitivity Protection Blend"
        },
        {

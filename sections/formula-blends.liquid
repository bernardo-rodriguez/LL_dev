          "id": "summary",
          "label": "Summary",
          "default": "Keeps dentist-grade strength comfortable"
        },
        {
          "type": "textarea",
          "id": "ingredients",
          "label": "Ingredients (one per line) — fallback",
          "info": "Only used when this blend has no Ingredient blocks under it. Format: Ingredient name | its role. Add Ingredient blocks instead to get per-ingredient images."
        }
      ]
    },
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "paragraph",
          "content": "Belongs to the Blend block above it. Drag to reorder or move between blends."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Shown at 112×78 on desktop, 100×72 on mobile. Leave empty for a placeholder."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Ingredient name",
          "default": "Glycerin"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role",
          "default": "hydration barrier"
        }
      ]
    },
    {
      "type": "trust",
      "name": "Trust marker",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon",
          "info": "Leave empty to use a checkmark"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Clinically Tested"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Detail",
          "default": "74% increase in brightness over 14 days"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Formula Blends",
      "blocks": [
        {

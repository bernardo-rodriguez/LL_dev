{{ 'section-key-benefits-list.css' | asset_url | stylesheet_tag }}

<section class="key-benefits-list" id="key-benefits-{{ section.id }}">
  <div class="page-width">
    <div class="key-benefits-list__inner">
      {% if section.settings.heading != blank %}
        <h3 class="key-benefits-list__title h3">{{ section.settings.heading }}</h3>
      {% endif %}
      <div class="key-benefits-list__grid">
        {% assign item_index = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'item' %}
            {% assign item_index = item_index | plus: 1 %}
            <div class="key-benefits-list__item" {{ block.shopify_attributes }}>
              <div class="key-benefits-list__item-icon-wrap">
                <div class="key-benefits-list__item-icon">
                  {% if block.settings.image != blank %}
                    <img
                      src="{{ block.settings.image | image_url: width: 160 }}"
                      alt="{{ block.settings.title | escape }}"
                      width="80"
                      height="80"
                      loading="lazy"
                    >
                  {% else %}
                    <span class="key-benefits-list__item-number" aria-hidden="true">{{ item_index }}</span>
                  {% endif %}
                </div>
              </div>
              <div class="key-benefits-list__item-content">
                {% if block.settings.title != blank %}
                  <h4 class="key-benefits-list__item-title h4">{{ block.settings.title }}</h4>
                {% endif %}
                {% if block.settings.description != blank %}
                  {%- assign description_inline = block.settings.description
                    | replace: '</p><p>', '<br><br>'
                    | remove: '<p>'
                    | remove: '</p>'
                  -%}
                  <p class="key-benefits-list__item-description sh2-5">{{ description_inline }}</p>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Key Benefits List",
  "tag": "section",
  "class": "section-key-benefits-list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading"
    }
  ],
  "blocks": [
    {
      "name": "Benefit",
      "type": "item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon / Image",
          "info": "Optional. Leave empty to use the numbered circle."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Benefit title"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Insert description</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Key Benefits List",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "title": "Double The Strength.",
            "description": "<p>Generic whitening is largely limited to <strong>7%</strong> hydrogen peroxide. Our personalized formulas reach <strong>14%</strong> hydrogen peroxide — <strong>Double the strength, Double the Results.</strong></p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Bigger And Faster Results.",
            "description": "<p><strong>Higher Strength = Better Whitening, Faster.</strong> Prescription strength whitening is able to break down the deepest stains. Notice a difference in just one week.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Long-Lasting Results",
            "description": "<p>Our formulas don\u2019t just lift surface stains\u2014they change the intrinsic color of your teeth for results that last. Deeper whitening that lasts over a year.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Pain-Free Guarantee",
            "description": "<p>With our quiz, we calculate how much sensitivity our formula could cause you, then increase the amount of sensitivity blockers to prevent any pain. <strong>Zero Sensitivity.</strong></p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Made & Used By Dentists",
            "description": "<p>Laughland is clinically trialed and recommended by dentists \u2014 because it\u2019s how they\u2019d do it. Professional-grade strength, customized to you, without the office visit.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{{ 'section-smile-analysis.css' | asset_url | stylesheet_tag }}
{{ 'section-personalized-pdp.css' | asset_url | stylesheet_tag }}

{% assign formatted_heading = section.settings.heading
  | replace: '{', "<span class='stylized'>"
  | replace: '}', '</span>'
%}
{% assign causes = section.blocks | where: 'type', 'cause' %}

<section
  class="smile-analysis {% if section.settings.margin_bottom %}smile-analysis--with-spacing{% endif %}"
  data-section-id="{{ section.id }}"
  {% if section.settings.flow_visibility == 'quiz' %}data-ll-only="quiz"{% elsif section.settings.flow_visibility == 'direct' %}data-ll-only="direct"{% endif %}
>
  <div class="page-width {% if template.name == 'product' %}page-width--product{% endif %}">
    <div class="smile-analysis__inner" data-ll-formula-scope>
      {%- comment -%}
        Per-formula wording. The formula is only known in the browser, so all
        three are emitted and formula-variants.js picks one.
      {%- endcomment -%}
      {%- assign copy_blocks = section.blocks | where: 'type', 'copy' -%}
      {%- assign has_formula_copy = false -%}
      {%- if copy_blocks.size > 0 -%}{%- assign has_formula_copy = true -%}{%- endif -%}
      {%- if copy_blocks.size > 0 -%}
        <script type="application/json" data-ll-formula-copy>
          {
            {%- for block in copy_blocks -%}
              {{ block.settings.formula | json }}: {
                "eyebrow": {{ block.settings.eyebrow | default: '' | json }},
                "heading": {{ block.settings.heading | default: '' | json }},
                "body": {{ block.settings.body | default: '' | json }}
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          }
        </script>
      {%- endif -%}

      {%- comment -%}
        The eyebrow greets the quiz taker. When it carries a {name} token it
        starts hidden and quiz-name.js fills it in — or removes it, if we
        never learned a name.
      {%- endcomment -%}
      {% if section.settings.eyebrow != blank %}
        {%- assign eyebrow_lower = section.settings.eyebrow | downcase -%}
        {%- assign wants_name = false -%}
        {%- if eyebrow_lower contains '{name}' or eyebrow_lower contains '{insert name}' or eyebrow_lower contains '{first_name}' or eyebrow_lower contains '{firstname}' -%}
          {%- assign wants_name = true -%}
        {%- endif -%}
        <p
          class="section-eyebrow smile-analysis__eyebrow label-sm"
          data-ll-formula-eyebrow
          data-quiz-name="{{ section.settings.eyebrow | escape }}"
          {% if wants_name %}hidden{% endif %}
        >{% unless wants_name %}{{ section.settings.eyebrow }}{% endunless %}</p>
      {% endif %}
      {%- comment -%}
        Rendered even when blank once per-formula copy exists, so an override
        has an element to fill — otherwise a formula could never add a line
        the section itself leaves empty.
      {%- endcomment -%}
      {% if section.settings.heading != blank or has_formula_copy %}
        <h3 class="section-heading smile-analysis__heading" data-ll-formula-heading {% if section.settings.heading == blank %}hidden{% endif %}>{{ formatted_heading }}</h3>
      {% endif %}
      {% if section.settings.body != blank or has_formula_copy %}
        <p class="smile-analysis__body body-md" data-ll-formula-body {% if section.settings.body == blank %}hidden{% endif %}>{{ section.settings.body }}</p>
      {% endif %}

      {% if causes.size > 0 %}
        {%- comment -%}
          Tiles over one panel, all closed to start, as the v6 reference draws
          it. Each tile owns its own panel in the markup rather than a shared
          one filled by script, so the copy is in the page for search and for
          anyone whose JS never runs.
        {%- endcomment -%}
        <div class="smile-analysis__cards">
          {% for block in causes %}
            <button
              type="button"
              class="smile-analysis__card"
              id="chip-{{ section.id }}-{{ forloop.index }}"
              aria-controls="panel-{{ section.id }}-{{ forloop.index }}"
              aria-expanded="false"
              data-chip="{{ forloop.index }}"
              data-ll-formula="{{ block.settings.formula | default: 'all' }}"
              {{ block.shopify_attributes }}
            >
              <span class="smile-analysis__art" {% if block.settings.tint != blank %}style="background: {{ block.settings.tint }};"{% endif %}>
                {% if block.settings.image != blank %}
                  <img
                    src="{{ block.settings.image | image_url: width: 400 }}"
                    alt="{{ block.settings.image.alt | default: block.settings.label | escape }}"
                    loading="lazy"
                  >
                {% endif %}
              </span>
              <span class="smile-analysis__card-label">
                <span class="smile-analysis__card-name">{{ block.settings.label }}</span>
                <span class="smile-analysis__plus" aria-hidden="true">+</span>
              </span>
            </button>
          {% endfor %}
        </div>

        {% for block in causes %}
          <div
            class="smile-analysis__panel"
            id="panel-{{ section.id }}-{{ forloop.index }}"
            data-ll-formula="{{ block.settings.formula | default: 'all' }}"
            aria-labelledby="chip-{{ section.id }}-{{ forloop.index }}"
            data-panel="{{ forloop.index }}"
            hidden
          >
            <div class="smile-analysis__panel-head">
              <span class="smile-analysis__panel-id">
                <span class="smile-analysis__panel-dot" {% if block.settings.dot != blank %}style="background: {{ block.settings.dot }};"{% endif %} aria-hidden="true"></span>
                <span class="smile-analysis__panel-name sh3">{{ block.settings.label }}</span>
              </span>
              <button type="button" class="smile-analysis__close" data-close="{{ forloop.index }}" aria-label="{{ section.settings.close_label | escape }}">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                  <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </button>
            </div>
            <p class="smile-analysis__panel-text body-md">{{ block.settings.effect }}</p>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{{ 'component-formula-variants.css' | asset_url | stylesheet_tag }}
<script src="{{ 'formula-variants.js' | asset_url }}" defer></script>

<script src="{{ 'quiz-name.js' | asset_url }}" defer></script>

<script>
  (function () {
    var root = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!root) return;
    var chips = root.querySelectorAll('[data-chip]');
    var panels = root.querySelectorAll('[data-panel]');

    function show(want) {
      chips.forEach(function (c) {
        var on = c.getAttribute('data-chip') === want;
        c.classList.toggle('smile-analysis__card--on', on);
        c.setAttribute('aria-expanded', on ? 'true' : 'false');
      });
      panels.forEach(function (p) {
        p.hidden = p.getAttribute('data-panel') !== want;
      });
    }

    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        // Tapping the open tile closes it, which is how the reference behaves.
        var want = chip.getAttribute('aria-expanded') === 'true' ? null : chip.getAttribute('data-chip');
        show(want);
      });
    });

    root.querySelectorAll('[data-close]').forEach(function (btn) {
      btn.addEventListener('click', function () { show(null); });
    });
  })();
</script>

{% schema %}
{
  "name": "Smile Analysis",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Your analysis",
      "info": "Write {name} to greet the quiz taker. The whole line is dropped when no name is known."
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "We found 3 causes dulling your smile.",
      "info": "Wrap emphasized text in {} for the italic Canela style"
    },
    {
      "type": "text",
      "id": "body",
      "label": "Body copy",
      "default": "Tap each to see what's going on."
    },
    {
      "type": "text",
      "id": "close_label",
      "label": "Close button label",
      "default": "Close",
      "info": "Screen-reader name for the panel's close button."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "margin_bottom",
      "label": "Extra space below",
      "default": false,
      "info": "Off by default. Sections carry their spacing on top, so the next one supplies the gap."
    },
    {
      "type": "header",
      "content": "Personalization flow"
    },
    {
      "type": "select",
      "id": "flow_visibility",
      "label": "Show this section to",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "Everyone"
        },
        {
          "value": "quiz",
          "label": "Quiz arrivals only"
        },
        {
          "value": "direct",
          "label": "Direct arrivals only"
        }
      ],
      "info": "Preview either flow by adding ?ll_flow=quiz or ?ll_flow=direct to the page URL."
    }
  ],
  "blocks": [
    {
      "type": "cause",
      "name": "Cause",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Cause",
          "default": "Surface stains"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Illustration"
        },
        {
          "type": "color",
          "id": "tint",
          "label": "Illustration background",
          "default": "#F4ECE6"
        },
        {
          "type": "color",
          "id": "dot",
          "label": "Panel dot colour",
          "default": "#A87B2A"
        },
        {
          "type": "textarea",
          "id": "effect",
          "label": "Panel copy",
          "default": "Teeth look dull and yellowed, even just after brushing.",
          "info": "The one paragraph shown when the tile is open."
        },
        {
          "type": "select",
          "id": "formula",
          "label": "Show for formula",
          "default": "all",
          "options": [
            {
              "value": "all",
              "label": "Every formula"
            },
            {
              "value": "sensitive",
              "label": "Gentle (19-2)"
            },
            {
              "value": "medium",
              "label": "Everyday (8-16)"
            },
            {
              "value": "strong",
              "label": "Super Strength (8-17)"
            }
          ]
        }
      ]
    },
    {
      "type": "copy",
      "name": "Formula copy",
      "settings": [
        {
          "type": "select",
          "id": "formula",
          "label": "Formula",
          "default": "medium",
          "options": [
            {
              "value": "sensitive",
              "label": "Gentle (19-2)"
            },
            {
              "value": "medium",
              "label": "Everyday (8-16)"
            },
            {
              "value": "strong",
              "label": "Super Strength (8-17)"
            }
          ]
        },
        {
          "type": "textarea",
          "id": "heading",
          "label": "Heading",
          "info": "Leave blank to keep the section's own. Wrap emphasized text in {}"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body copy",
          "info": "Leave blank to keep the section's own."
        },
        {
          "type": "paragraph",
          "content": "Replaces the section's heading and body when this formula is on screen. Add one per formula."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Smile Analysis",
      "blocks": [
        {
          "type": "cause",
          "settings": {
            "label": "Surface stains",
            "tint": "#F4ECE6"
          }
        },
        {
          "type": "cause",
          "settings": {
            "label": "Plaque film",
            "tint": "#F6EFE2",
            "effect": "Light scatters instead of reflecting, so teeth look flat."
          }
        },
        {
          "type": "cause",
          "settings": {
            "label": "Deep stains",
            "tint": "#F2EAF1",
            "effect": "A yellow cast that brushing and strips cannot reach."
          }
        }
      ]
    }
  ]
}
{% endschema %}

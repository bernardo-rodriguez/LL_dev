{{ 'section-carousel.css' | asset_url | stylesheet_tag }}
{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
{{ 'section-what-to-expect.css' | asset_url | stylesheet_tag }} 

<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>

<div class="what-to-expect">
  <div class="box-container page-width">
    <div class="what-to-expect__wrapper what-to-expect__colored-wrapper">
      <div class="what-to-expect__content">
        <h3 class="what-to-expect__title">{{ section.settings.title }}</h3>
      </div>
      <div class="what-to-expect__mobile-wrapper">
        <div class="box-image">
          <div class="carousel">
            <div class="carousel__inner">
              <div class="carousel-instance swiper">
                <div class="swiper-wrapper">
                  {% for block in section.blocks %}
                    <div class="swiper-slide">
                      <div class="carousel__slide-content">
                        {% if block.settings.svg != blank %}
                          <div class="carousel-image">
                            {{ block.settings.svg }}
                          </div>
                        {% elsif block.settings.png != blank %}
                          <div class="carousel-image">
                            <img
                              srcset="
                                {{ block.settings.png | image_url: width: 400 }} 400w,
                                {{ block.settings.png | image_url: width: 600 }} 600w,
                                {{ block.settings.png | image_url: width: 800 }} 800w,
                                {{ block.settings.png | image_url: width: 1200 }} 1200w"
                              sizes="(max-width: 768px) 400px,
                                     (max-width: 991px) 600px,
                                     800px"
                              src="{{ block.settings.png | image_url: width: 800}}"
                              loading="lazy"
                              width="800"
                              height="800"
                              alt="{{ block.settings.png.alt | escape }}"
                              {% if block.settings.opacity != blank %}style="opacity: 0.{{ block.settings.opacity }}"{% endif %}
                            >
                          </div>
                        {% endif %}
                        <h3 class="carousel__slide-text">{{ block.settings.text }}</h3>
                      </div>
                    </div>
                  {% endfor %}
                </div>
                <div class="swiper-pagination"></div>
              </div>
              <div class="swiper-button-prev carousel-prev"></div>
              <div class="swiper-button-next carousel-next"></div>
            </div>
          </div>
        </div>

        <div class="box-content">
          <div class="box-feature">
            <div class="box-feature-icon">{{ section.settings.feature1_icon }}</div>
            <div class="box-feature-content">
              <h4 class = 'special-section-subheading'>{{ section.settings.feature1_title }}</h4>
              <span>{{ section.settings.feature1_text }}</span>
            </div>
          </div>

          <div class="box-feature">
            <div class="box-feature-icon">{{ section.settings.feature2_icon }}</div>
            <div class="box-feature-content">
              <h4 class = 'special-section-subheading'>{{ section.settings.feature2_title }}</h4>
              <span>{{ section.settings.feature2_text }}</span>
            </div>
          </div>

          <div class="box-feature">
            <div class="box-feature-icon">{{ section.settings.feature3_icon }}</div>
            <div class="box-feature-content">
              <h4 class = 'special-section-subheading'>{{ section.settings.feature3_title }}</h4>
              <span>{{ section.settings.feature3_text }}</span>
            </div>
          </div>

          <div class="box-feature">
            <div class="box-feature-icon">{{ section.settings.feature4_icon }}</div>
            <div class="box-feature-content">
              <h4 class = 'special-section-subheading'>{{ section.settings.feature4_title }}</h4>
              <span>{{ section.settings.feature4_text }}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .special-section-subheading {
    margin-bottom: 0;
  }
  .what-to-expect__wrapper {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid #E5E5E5;
  }

  .what-to-expect__colored-wrapper {
    padding: 30px;
    background: #f5faff;
  }

  .what-to-expect__content {
    text-align: center;
  }

  .box-container {
    margin: auto;
    padding-bottom: 50px;
    padding-top: 20px;
  }

  .what-to-expect__mobile-wrapper {
    display: flex;
    flex-wrap: wrap;
  }

  .mobile-title {
    display: none;
  }

  .box-image {
    flex: 0 0 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 50%;
  }

  .box-content {
    flex: 0 0 50%;
    padding: 40px;
    width: 50%;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .box-content h2 {
    font-size: 32px;
    font-weight: normal;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
  }

  .box-feature {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 20px;
  }

  .box-feature:last-of-type {
    margin-bottom: 0;
  }

  .box-feature-icon {
    flex-shrink: 0;
    width: 3.5rem;
    height: auto;
    marging-top: 5px;
    display: flex;
    align-items: center;
    font-size: 1.8rem;
    line-height: 1;
  }

  .box-feature-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .box-feature-content p {
    font-size: calc(var(--font-heading-scale) * 1.7rem);
    display: block;
    margin-bottom: 4px;
    font-weight: 500;
    line-height: 1;
  }

  .box-feature-content span {
    font-weight: 500;
  }

  .box-expect {
    margin-top: 30px;
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .box-expect-icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  .box-expect-content {
    font-size: 16px;
  }

  .box-expect-content p {
    display: block;
    margin-bottom: 4px;
    font-size: 18px;
  }

  .carousel {
    width: 100%;
  }

  .carousel__inner {
    display: grid;
    grid-template-columns: 50px minmax(0, 1fr) 50px;
    position: relative;
  }

  .carousel-instance {
    grid-column: 2/3;
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  .swiper-wrapper {
    display: flex;
    align-items: center;
  }

  .swiper-slide {
    display: flex;
    justify-content: center;
    align-items: center;
    height: auto;
  }

  .carousel-slide-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 400px;
    margin: 0 auto;
  }

  .carousel-image {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 0;
    min-height: 400px;
    border-radius: 30px;
  }

  .carousel-image img {
    width: 100%;
    height: auto;
    max-width: 400px;
    object-fit: contain;
    border-radius: 20px;
  }

  .carousel__slide-text {
    padding: 20px 0;
    max-width: 660px;
    margin: auto;
    text-align: center;
    font-size: 18px;
    font-weight: normal;
  }

  .swiper-button-prev,
  .swiper-button-next {
    color: var(--navy);
  }

  .swiper-button-prev {
    grid-column: 1/2;
    left: 0;
  }

  .swiper-button-next {
    grid-column: 3/4;
    right: 0;
  }

  .swiper-pagination-bullet {
    background-color: #CFD3DA;
    width: 9px;
    height: 9px;
    opacity: 1;
  }

  .swiper-pagination-bullet-active {
    background-color: var(--navy);
    opacity: 1;
  }

  .carousel-instance .swiper-pagination {
    display: flex !important;
    visibility: visible !important;
  }

  @media screen and (max-width: 991px) {
    .what-to-expect .box-content {
      flex: 0 0 100%;
      width: 100%;
      max-width: 100%;
      padding: 0;
    }

    .what-to-expect .box-image {
      flex: 0 0 100%;
      width: 100%;
      max-width: 100%;
    }
  }

  @media screen and (max-width: 749px) {
    .mobile-title {
      display: block;
      padding-top: 0;
      margin-bottom: 0;
    }
    
    .what-to-expect .box-image {
      padding-top: 0;
    }

    .box-feature {
      gap: 0.5rem;
    }

    .carousel__inner {
      grid-template-columns: 20px minmax(0, 1fr) 20px;
    }

    .carousel__slide-text {
      font-size: 18px;
      padding: 35px 20px;
    }
  }

  @media screen and (max-width: 460px) {
    .box-image {
      margin-top: -20px;
    }
  }
</style>

{% javascript %}
  const carousel = new Swiper('.carousel-instance', {
    slidesPerView: 1,
    autoplay: {
      speed: 7000,
    },
    loop: true,
    navigation: {
      nextEl: '.carousel-next',
      prevEl: '.carousel-prev',
    },
    pagination: {
      el: '.swiper-pagination',
      type: 'bullets',
    },
  });
{% endjavascript %}


{{ 'section-carousel.css' | asset_url | stylesheet_tag }}
{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
{{ 'section-what-to-expect.css' | asset_url | stylesheet_tag }} 

<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>

<section class="what-to-expect">
  <div class="box-container page-width">

    <div class="box-image">
      <div class="carousel">
          <div class="carousel__inner">
            <div class="carousel-instance swiper">
              <div class="swiper-wrapper">
                {% for block in section.blocks %}
                  <div class="swiper-slide">
                    <div class="carousel__slide-content">
                      {% if block.settings.svg != blank %}
                        <div class="carousel-image">
                          {{ block.settings.svg }}
                        </div>
                      {% elsif block.settings.png != blank %}
                        <div class="carousel-image">
                          <img
                            srcset="
                              {{ block.settings.png | image_url: width: 400 }} 400w,
                              {{ block.settings.png | image_url: width: 600 }} 600w,
                              {{ block.settings.png | image_url: width: 800 }} 800w,
                              {{ block.settings.png | image_url: width: 1200 }} 1200w"
                            sizes="(max-width: 768px) 400px,
                                   (max-width: 991px) 600px,
                                   800px"
                            src="{{ block.settings.png | image_url: width: 800}}"
                            loading="lazy"
                            width="800"
                            height="800"
                            alt="{{ block.settings.png.alt | escape }}"
                            {% if block.settings.opacity != blank %}style="opacity: 0.{{ block.settings.opacity }}"{% endif %}
                          >
                        </div>
                      {% endif %}
                      <h3 class="carousel__slide-text m-h5">{{ block.settings.text }}</h3>
                    </div>
                  </div>
                {% endfor %}
              </div>
              <div class="swiper-pagination"></div>
            </div>
            <div class="swiper-button-prev carousel-prev"></div>
            <div class="swiper-button-next carousel-next"></div>
          </div>
      </div>
    </div>

    <div class="box-content">
      <h2>📦 What's in the box?</h2>

      <div class="box-feature">
        <div class="box-feature-icon">🪥</div>
        <div class="box-feature-content">
          <strong>6 Treatments</strong>
          <span>Dentist-formulated for safe, effective whitening</span>
        </div>
      </div>

      <div class="box-feature">
        <div class="box-feature-icon">⭐</div>
        <div class="box-feature-content">
          <strong>5+ Shades Brighter</strong>
          <span>Noticeably whiter teeth after completing the kit</span>
        </div>
      </div>

      <div class="box-feature">
        <div class="box-feature-icon">💧</div>
        <div class="box-feature-content">
          <strong>8% Hydrogen Peroxide</strong>
          <span>Professional strength for powerful whitening</span>
        </div>
      </div>

      <div class="box-expect">
        <div class="box-expect-icon">😊</div>
        <div class="box-expect-content">
          <strong>What to Expect</strong>
          Reveal your brightest smile in just 6 easy treatments. Most customers see a visibly whiter, more radiant smile—up to 5+ shades brighter—by the end of the kit. Safe for sensitive teeth and formulated by dental professionals.
        </div>
      </div>

    </div>
  </div>
</section>

<style>
    .box-container {
      display: flex;
      flex-wrap: wrap;
      background: white;
      border-radius: 16px;
      overflow: hidden;
      margin: auto;
      padding-bottom: 50px;
      padding-top: 20px;
    }

    .box-image {
      flex: 0 0 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(to bottom right, #ffffff, #f5faff);
      padding-top: 40px;
      padding-bottom: 20px;
      border-radius: 16px;
      width: 50%;
    }

    .box-content {
      flex: 0 0 50%;
      padding: 40px;
      background-color: var(--blue-tint-20)
      width: 50%;
    }

    .box-content h2 {
      font-size: 24px;
      font-weight: bold;
      color: #123087;
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 24px;
    }

    .box-feature {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      margin-bottom: 20px;
    }

    .box-feature-icon {
      width: 32px;
      height: 32px;
      flex-shrink: 0;
    }

    .box-feature-content strong {
      font-size: 16px;
      display: block;
    }

    .box-feature-content span {
      font-size: 14px;
      color: #444;
    }

    .box-expect {
      margin-top: 30px;
      display: flex;
      gap: 12px;
      align-items: flex-start;
    }

    .box-expect-icon {
      width: 24px;
      height: 24px;
      flex-shrink: 0;
    }

    .box-expect-content {
      font-size: 14px;
      color: #333;
    }

    .box-expect-content strong {
      color: #123087;
      display: block;
      margin-bottom: 4px;
    }

    .carousel {
      width: 100%;
    }

    .carousel__inner {
      display: grid;
      grid-template-columns: 50px minmax(0, 1fr) 50px;
      position: relative;
    }

    .carousel-instance {
      grid-column: 2/3;
      width: 100%;
      overflow: hidden;
      position: relative;
    }

    .swiper-wrapper {
      display: flex;
      align-items: center;
    }

    .swiper-slide {
      display: flex;
      justify-content: center;
      align-items: center;
      height: auto;
    }

    .carousel-slide-inner {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      max-width: 500px;
      margin: 0 auto;
    }

    .carousel-image {
      width: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
      margin-bottom: 0;
      min-height: 400px;
      border-radius: 30px;
    }

    .carousel-image img {
      width: 100%;
      height: auto;
      max-width: 500px;
      object-fit: contain;
      border-radius: 20px;
    }

    .carousel__slide-text {
      padding: 20px 0;
      max-width: 660px;
      margin: auto;
      text-align: center;
    }

    .swiper-button-prev,
    .swiper-button-next {
      color: var(--navy);
    }

    .swiper-button-prev {
      grid-column: 1/2;
      left: 0;
    }

    .swiper-button-next {
      grid-column: 3/4;
      right: 0;
    }

    .swiper-pagination-bullet {
      background-color: #CFD3DA;
      width: 9px;
      height: 9px;
      opacity: 1;
    }

    .swiper-pagination-bullet-active {
      background-color: var(--navy);
      opacity: 1;
    }

    .carousel-instance .swiper-pagination {
      display: flex !important;
      visibility: visible !important;
    }

    @media screen and (max-width: 991px) {
      .box-image, .box-content {
        flex: 0 0 100%;
        width: 100%;
        max-width: 100%;
      }

      .carousel__slide-text {
        font-size: 30px;
        padding: 40px 20px;
      }
    }

    @media screen and (max-width: 768px) {
      .carousel__inner {
        grid-template-columns: 20px minmax(0, 1fr) 20px;
      }

      .carousel__slide-text {
        font-size: 20px;
        padding: 35px 20px;
      }

      .carousel {
        margin: 30px 0;
      }

      .carousel-image {
        min-height: 300px;
        border-radius: 20px;
      }

      .carousel-image img {
        border-radius: 15px;
      }
    }
</style>

{% javascript %}
  const carousel = new Swiper('.carousel-instance', {
    slidesPerView: 1,
    autoplay: {
      speed: 7000,
    },
    loop: true,
    navigation: {
      nextEl: '.carousel-next',
      prevEl: '.carousel-prev',
    },
    pagination: {
      el: '.swiper-pagination',
      type: 'bullets',
    },
  });
{% endjavascript %}

{% schema %}
{
  "name": "What to expect",
  "blocks": [
    {
      "type": "ll_expect",
      "name": "LL_expect",
      "settings": [
      ]
    },
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "textarea",
          "id": "svg",
          "label": "SVG Logo"
        },
        {
          "type": "image_picker",
          "id": "png",
          "label": "PNG Logo",
          "info": "SVG is preferred, but PNG can be used instead"
        },
        {
          "type": "number",
          "id": "opacity",
          "label": "(Optional) Opacity level: 1-9",
          "info": "1 = lightest, 9 = darkest)"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LL Expect"
    }
  ]
}
{% endschema %}
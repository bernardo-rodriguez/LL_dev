          "info": "1 = lightest, 9 = darkest)"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LL Expect"
    }
  ]
}
{% endschema %}
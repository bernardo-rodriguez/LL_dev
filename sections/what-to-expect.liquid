    },
    {
      "type": "header",
      "content": "Feature 4"
    },
    {
      "type": "text",
      "id": "feature4_icon",
      "label": "Feature 4 Icon",
      "default": "😊"
    },
    {
      "type": "text",
      "id": "feature4_title",

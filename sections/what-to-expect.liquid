    },
    {
      "type": "text",
      "id": "feature2_title",
      "label": "Feature 2 Title",
      "default": "5+ Shades Brighter"
    },
    {
      "type": "text",
      "id": "feature2_text",
      "label": "Feature 2 Text",
      "default": "Noticeably whiter teeth after completing the kit"
    },
    {
      "type": "header",
      "content": "Feature 3"
    },
    {
      "type": "text",
      "id": "feature3_icon",
      "label": "Feature 3 Icon",
      "default": "💧"
    },
    {
      "type": "text",
      "id": "feature3_title",
      "label": "Feature 3 Title",
      "default": "8% Hydrogen Peroxide"
    },
    {
      "type": "text",
      "id": "feature3_text",

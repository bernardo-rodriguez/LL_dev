{{ 'section-quiz-cta-panel.css' | asset_url | stylesheet_tag }}

{% assign formatted_heading = section.settings.heading
  | replace: '{', "<span class='stylized'>"
  | replace: '}', '</span>'
%}

<section
  class="quiz-cta-panel {% if section.settings.margin_bottom %}quiz-cta-panel--with-spacing{% endif %}"
  data-section-id="{{ section.id }}"
  {% if section.settings.flow_visibility == 'quiz' %}data-ll-only="quiz"{% elsif section.settings.flow_visibility == 'direct' %}data-ll-only="direct"{% endif %}
>
  <div class="page-width">
    <div class="quiz-cta-panel__inner">
      {% if section.settings.eyebrow != blank %}
        <p class="quiz-cta-panel__eyebrow label-sm">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h3 class="section-heading quiz-cta-panel__heading">{{ formatted_heading }}</h3>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a
          class="button quiz-cta-panel__cta"
          {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}href="#"{% endif %}
          {% if section.settings.button_opens_quiz %}data-open-quiz{% endif %}
        >{{ section.settings.button_label }}</a>
      {% endif %}

      {% if section.settings.note != blank %}
        <p class="quiz-cta-panel__note body-sm">{{ section.settings.note }}</p>
      {% endif %}

      {% if section.settings.guarantee != blank %}
        <p class="quiz-cta-panel__guarantee body-sm">{{ section.settings.guarantee }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Quiz CTA Panel",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Free 2-minute quiz"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Find out what's holding your smile back.",
      "info": "Wrap emphasized text in {} for the italic Canela style"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Build my formula"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "button_opens_quiz",
      "label": "Button opens the quiz",
      "default": true
    },
    {
      "type": "text",
      "id": "note",
      "label": "Line under the button",
      "default": "Then your kit is $39 (reg. $65)."
    },
    {
      "type": "text",
      "id": "guarantee",
      "label": "Guarantee line",
      "default": "Noticeably whiter in 30 days or your money back."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "margin_bottom",
      "label": "Extra space below",
      "default": false,
      "info": "This panel sits flush against the section above it and carries its spacing underneath. Turn this on to double that gap."
    },
    {
      "type": "header",
      "content": "Personalization flow"
    },
    {
      "type": "select",
      "id": "flow_visibility",
      "label": "Show this section to",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "Everyone"
        },
        {
          "value": "quiz",
          "label": "Quiz arrivals only"
        },
        {
          "value": "direct",
          "label": "Direct arrivals only"
        }
      ],
      "info": "Preview either flow by adding ?ll_flow=quiz or ?ll_flow=direct to the page URL."
    }
  ],
  "presets": [
    {
      "name": "Quiz CTA Panel"
    }
  ]
}
{% endschema %}

{{ 'section-treatment-plan.css' | asset_url | stylesheet_tag }}
{{ 'section-personalized-pdp.css' | asset_url | stylesheet_tag }}

{% assign formatted_heading = section.settings.heading
  | replace: '{', "<span class='stylized'>"
  | replace: '}', '</span>'
%}
{% assign treatments = section.blocks | where: 'type', 'treatment' %}

<section
  class="treatment-plan {% if section.settings.margin_bottom %}treatment-plan--with-spacing{% endif %}"
  data-section-id="{{ section.id }}"
  {% if section.settings.flow_visibility == 'quiz' %}data-ll-only="quiz"{% elsif section.settings.flow_visibility == 'direct' %}data-ll-only="direct"{% endif %}
>
  <div class="page-width {% if template.name == 'product' %}page-width--product{% endif %}">
    <div class="treatment-plan__inner" data-ll-formula-scope>
      {%- comment -%}
        Per-formula wording. The formula is only known in the browser, so all
        three are emitted and formula-variants.js picks one.
      {%- endcomment -%}
      {%- assign copy_blocks = section.blocks | where: 'type', 'copy' -%}
      {%- assign has_formula_copy = false -%}
      {%- if copy_blocks.size > 0 -%}{%- assign has_formula_copy = true -%}{%- endif -%}
      {%- if copy_blocks.size > 0 -%}
        <script type="application/json" data-ll-formula-copy>
          {
            {%- for block in copy_blocks -%}
              {{ block.settings.formula | json }}: {
                "eyebrow": {{ block.settings.eyebrow | default: '' | json }},
                "heading": {{ block.settings.heading | default: '' | json }},
                "body": {{ block.settings.body | default: '' | json }}
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          }
        </script>
      {%- endif -%}

      <div class="treatment-plan__intro">
        {% if section.settings.eyebrow != blank %}
          <p class="section-eyebrow treatment-plan__eyebrow label-sm" data-ll-formula-eyebrow>{{ section.settings.eyebrow }}</p>
        {% endif %}
      {%- comment -%}
        Rendered even when blank once per-formula copy exists, so an override
        has an element to fill — otherwise a formula could never add a line
        the section itself leaves empty.
      {%- endcomment -%}
        {% if section.settings.heading != blank or has_formula_copy %}
          <h3 class="section-heading treatment-plan__heading" data-ll-formula-heading {% if section.settings.heading == blank %}hidden{% endif %}>{{ formatted_heading }}</h3>
        {% endif %}
        {% if section.settings.body != blank or has_formula_copy %}
          <p class="treatment-plan__body body-md" data-ll-formula-body {% if section.settings.body == blank %}hidden{% endif %}>{{ section.settings.body }}</p>
        {% endif %}
      </div>

      {% if treatments.size > 0 %}
        {%- comment -%}
          Ruled rows on a navy band: what is being treated on the left, the dot
          tying it back to the cause above it, then what treats it. The three
          columns are fixed so the arrows line up down the page.
        {%- endcomment -%}
        <div class="treatment-plan__grid">
          <ul class="treatment-plan__rows list-unstyled">
            {% for block in treatments %}
              <li class="treatment-plan__item" data-ll-formula="{{ block.settings.formula | default: 'all' }}" {{ block.shopify_attributes }}>
                <span class="treatment-plan__target">
                  {% if block.settings.dot != blank or block.settings.dot_two != blank %}
                    <span class="treatment-plan__dots" aria-hidden="true">
                      {% if block.settings.dot != blank %}
                        <span class="treatment-plan__dot" style="background: {{ block.settings.dot }};"></span>
                      {% endif %}
                      {% if block.settings.dot_two != blank %}
                        <span class="treatment-plan__dot" style="background: {{ block.settings.dot_two }};"></span>
                      {% endif %}
                    </span>
                  {% endif %}
                  <span class="treatment-plan__cause">{{ block.settings.cause }}</span>
                </span>

                <span class="treatment-plan__arrow" aria-hidden="true">
                  <svg viewBox="0 0 20 12" fill="none" focusable="false">
                    <path d="M1 6h17m0 0-5-4.5M18 6l-5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>

                <span class="treatment-plan__treatment">
                  <span class="treatment-plan__agent">{{ block.settings.agent }}</span>
                  <span class="treatment-plan__effect">{{ block.settings.effect }}</span>
                </span>
              </li>
            {% endfor %}
          </ul>

          {% if section.settings.meta_left != blank or section.settings.meta_right != blank %}
            <p class="treatment-plan__meta">
              <span>{{ section.settings.meta_left }}</span>
              <span>{{ section.settings.meta_right }}</span>
            </p>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{{ 'component-formula-variants.css' | asset_url | stylesheet_tag }}
<script src="{{ 'formula-variants.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Treatment Plan",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Your treatment"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Here's how we treat it.",
      "info": "Wrap emphasized text in {} for the italic Canela style"
    },
    {
      "type": "text",
      "id": "body",
      "label": "Body copy",
      "default": "One 20-min session a day treats all of it."
    },
    {
      "type": "header",
      "content": "Footer row"
    },
    {
      "type": "text",
      "id": "meta_left",
      "label": "Footer left",
      "default": "Formula 8-17"
    },
    {
      "type": "text",
      "id": "meta_right",
      "label": "Footer right",
      "default": "20 min · 6 days"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "margin_bottom",
      "label": "Extra space below",
      "default": false,
      "info": "Off by default. Sections carry their spacing on top, so the next one supplies the gap."
    },
    {
      "type": "header",
      "content": "Personalization flow"
    },
    {
      "type": "select",
      "id": "flow_visibility",
      "label": "Show this section to",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "Everyone"
        },
        {
          "value": "quiz",
          "label": "Quiz arrivals only"
        },
        {
          "value": "direct",
          "label": "Direct arrivals only"
        }
      ],
      "info": "Preview either flow by adding ?ll_flow=quiz or ?ll_flow=direct to the page URL."
    }
  ],
  "blocks": [
    {
      "type": "treatment",
      "name": "Treatment",
      "settings": [
        {
          "type": "text",
          "id": "cause",
          "label": "What it treats",
          "default": "Surface + deep stains"
        },
        {
          "type": "color",
          "id": "dot",
          "label": "Dot",
          "info": "Match the cause above. Leave empty for none."
        },
        {
          "type": "color",
          "id": "dot_two",
          "label": "Second dot",
          "info": "For a row covering two causes."
        },
        {
          "type": "text",
          "id": "agent",
          "label": "Active",
          "default": "Hydrogen peroxide + LED"
        },
        {
          "type": "text",
          "id": "effect",
          "label": "What it does",
          "default": "Lifts stains, surface to deep."
        },
        {
          "type": "select",
          "id": "formula",
          "label": "Show for formula",
          "default": "all",
          "options": [
            {
              "value": "all",
              "label": "Every formula"
            },
            {
              "value": "sensitive",
              "label": "Gentle (19-2)"
            },
            {
              "value": "medium",
              "label": "Everyday (8-16)"
            },
            {
              "value": "strong",
              "label": "Super Strength (8-17)"
            }
          ]
        }
      ]
    },
    {
      "type": "copy",
      "name": "Formula copy",
      "settings": [
        {
          "type": "select",
          "id": "formula",
          "label": "Formula",
          "default": "medium",
          "options": [
            {
              "value": "sensitive",
              "label": "Gentle (19-2)"
            },
            {
              "value": "medium",
              "label": "Everyday (8-16)"
            },
            {
              "value": "strong",
              "label": "Super Strength (8-17)"
            }
          ]
        },
        {
          "type": "textarea",
          "id": "heading",
          "label": "Heading",
          "info": "Leave blank to keep the section's own. Wrap emphasized text in {}"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body copy",
          "info": "Leave blank to keep the section's own."
        },
        {
          "type": "paragraph",
          "content": "Replaces the section's heading and body when this formula is on screen. Add one per formula."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Treatment Plan",
      "blocks": [
        {
          "type": "treatment",
          "settings": {
            "cause": "Surface + deep stains",
            "agent": "Hydrogen peroxide + LED",
            "effect": "Lifts stains, surface to deep.",
            "dot": "#8A5A3C",
            "dot_two": "#73476E"
          }
        },
        {
          "type": "treatment",
          "settings": {
            "cause": "Plaque film",
            "agent": "Bicarb + coconut oil",
            "effect": "Clears the dulling film.",
            "dot": "#A87B2A"
          }
        },
        {
          "type": "treatment",
          "settings": {
            "cause": "Thin enamel",
            "agent": "Hydroxyapatite",
            "effect": "Strengthens thin spots.",
            "dot": "#4F7A91"
          }
        }
      ]
    }
  ]
}
{% endschema %}

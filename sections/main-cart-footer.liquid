{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}
<script src="{{ 'in-house-tracking-constants.js' | asset_url }}"></script>

<div class="page-width{% if cart == empty %} is-empty{% endif %}" id="main-cart-footer" data-id="{{ section.id }}">
  <div>
    <div class="cart__footer">
      {% if section.settings.show_cart_note %}
        <cart-note class="cart__note field">
          <label for="Cart-note">{{ 'sections.cart.note' | t }}</label>
          <textarea
            class="text-area text-area--resize-vertical field__input"
            name="note"
            form="cart"
            id="Cart-note"
            placeholder="{{ 'sections.cart.note' | t }}"
          >{{ cart.note }}</textarea>
        </cart-note>
      {% endif %}

      <div class="cart__blocks">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when '@app' %}
              {% render block %}
            {% when 'subtotal' %}
              <div class="js-contents" {{ block.shopify_attributes }}>
                <div class="totals">
                  <h3 class="totals__subtotal">{{ 'sections.cart.subtotal' | t }}</h3>
                  <p class="totals__subtotal-value">{{ cart.total_price | money_with_currency }}</p>
                </div>

                <div>
                  {% if cart.cart_level_discount_applications.size > 0 %}
                    <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                      {% for discount in cart.cart_level_discount_applications %}
                        <li class="discounts__discount discounts__discount--end">
                          {% render 'icon', icon: 'discount' %}
                          {{ discount.title }}
                          (-{{ discount.total_allocated_amount | money }})
                        </li>
                      {% endfor %}
                    </ul>
                  {% endif %}
                </div>

                <small class="tax-note caption-large rte">
                  {% if cart.taxes_included and shop.shipping_policy.body != blank %}
                    {{ 'sections.cart.taxes_included_and_shipping_policy_html' | t: link: shop.shipping_policy.url }}
                  {% elsif cart.taxes_included %}
                    {{ 'sections.cart.taxes_included_but_shipping_at_checkout' | t }}
                  {% elsif shop.shipping_policy.body != blank %}
                    {{ 'sections.cart.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url }}
                  {% else %}
                    {{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}
                  {% endif %}
                </small>
              </div>
            {% else %}
              <div class="cart__ctas" {{ block.shopify_attributes }}>
                <noscript>
                  <button type="submit" class="cart__update-button button button--secondary" form="cart">
                    {{ 'sections.cart.update' | t }}
                  </button>
                </noscript>

                <button
                  type="submit"
                  id="checkout"
                  class="cart__checkout-button button"
                  name="checkout"
                  {% if cart == empty %}
                    disabled
                  {% endif %}
                  form="cart"
                >
                  {{ 'sections.cart.checkout' | t }}
                </button>
                
              </div>

              {% if additional_checkout_buttons %}
                {% comment %} <div class="cart__dynamic-checkout-buttons additional-checkout-buttons">
                  {{ content_for_additional_checkout_buttons }}
                </div> {% endcomment %}
              {% endif %}
          {% endcase %}
        {% endfor %}

        <div id="cart-errors"></div>
      </div>
    </div>
  </div>
</div>

{% javascript %}
  class CartNote extends HTMLElement {
    constructor() {
      super();

      this.addEventListener(
        'change',
        debounce((event) => {
          const body = JSON.stringify({ note: event.target.value });
          fetch(`${routes.cart_update_url}`, { ...fetchConfig(), ...{ body } });
        }, 300)
      );
    }
  }

  customElements.define('cart-note', CartNote);
{% endjavascript %}

<script>
  function getCookie(name) {
    value = `; ${document.cookie}`;
    parts = value.split(`; ${name}=`);
    if (parts.length === 2) return parts.pop().split(';').shift();
  }
{% comment %} 
  discount_dict = { // legacy discounts
    'redirect_paceline': 'PACELINE_AUTOMATIC',
    'redirect_sweatcoin': 'Pen-Addon',
    'redirect_ut': 'ADD_PEN',
    'redirect_ut_direct': null,
    'redirect_miles': 'MILES_AUTOMATIC',
    'redirect_skimm': 'SKIMM25',
    'redirect_pinterest': 'PINTEREST25',
    'redirect_cpgap': 'Pen-Addon',
    'redirect_cpgap_gen': 'Pen-Addon',
    'jam_media': 'AFFILIATE-DISCOUNT-TJM',
  } {% endcomment %}
  
  const direct_checkout = getCookie('directcheckout');
  if (direct_checkout == 'true') {
    document.cookie = 'directcheckout=expires=Thu, 01 Jan 1970 00:00:01 GMT';
    try {

      productDiscountCode = getCookie('productDiscountCode');
      console.log("Cart productDiscountCode ::",productDiscountCode);
      url_params = [];

      a_referrer = getCookie('affiliate_referrer')
      bundle_discount = getCookie('bundle_discount')
      if (a_referrer in affiliate_config && 'flow' in affiliate_config[a_referrer] && 'discount_code' in affiliate_config[a_referrer]['flow']) {
        if (affiliate_config[a_referrer]['flow']['discount_code']) {
          if (bundle_discount !== null && bundle_discount !== '') {
            url_params = url_params.concat(['discount=' + bundle_discount]);
          } else {
            url_params = url_params.concat(['discount=' + affiliate_config[a_referrer]['flow']['discount_code']]);
          }
        }
      }

      manual_discount = getCookie('manual_discount')
      if (manual_discount !== null && manual_discount !== '') {
        url_params = url_params.concat(['discount=' + manual_discount]);
        document.cookie = 'manual_discount=;expires=Thu, 01 Jan 1970 00:00:01 GMT';
      }

      if(productDiscountCode != "" && productDiscountCode != undefined){
        url_params = [`discount=${productDiscountCode}`]; // TODO: should I be appeding here?
        document.cookie = 'productDiscountCode=;expires=Thu, 01 Jan 1970 00:00:01 GMT';
      }
      console.log(url_params);

      window.location.href = '/checkout?' + url_params.join('&');
    } catch (err) {
      console.log(err);
      window.location.href = '/checkout';
      // window.location.href = '/checkout?discount=SWEATCOIN_AUTOMATIC';
    }
  } else {
    document.querySelector('.page-transition').classList.toggle('visible');
  }

  if (getCookie('affiliate_referrer') == 'redirect_paceline') {
    $('.announcement-bar__message').first().html('PACELINE SALE! DISCOUNT AUTOMATICALLY APPLIED AT CHECKOUT');
  } else if (getCookie('affiliate_referrer') == 'redirect_sweatcoin') {
    $('.announcement-bar__message').first().html('SWEATCOIN SALE! DISCOUNT AUTOMATICALLY APPLIED AT CHECKOUT');
  }
</script>

{% schema %}
{
  "name": "t:sections.main-cart-footer.name",
  "class": "cart__footer-wrapper",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_cart_note",
      "default": false,
      "label": "t:sections.main-cart-footer.settings.show_cart_note.label"
    }
  ],
  "blocks": [
    {
      "type": "subtotal",
      "name": "t:sections.main-cart-footer.blocks.subtotal.name",
      "limit": 1
    },
    {
      "type": "buttons",
      "name": "t:sections.main-cart-footer.blocks.buttons.name",
      "limit": 1
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}

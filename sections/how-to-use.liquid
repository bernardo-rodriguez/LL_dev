{% schema %}
{
  "name": "How To Use",
  "tag": "section",
  "class": "how-to-use-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "How to use"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "Step Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Step Description",
          "default": "Step description goes here"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How To Use"
    }
  ]
}
{% endschema %}

<section class="how-to-use-section">
  <div class="page-width">
    <div class="how-to-use-header">
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="how-to-use-steps">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'step' %}
            <div class="how-step" {{ block.shopify_attributes }}>
              {% assign step_number = forloop.index %}
              <img 
                src="{{ 'how-to-use-' | append: step_number | append: '.webp' | asset_url }}" 
                alt="Step {{ step_number }} - {{ block.settings.title }}"
                width="260"
                height="260"
                loading="lazy"
              />
              <div class="text-content">
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.description }}</p>
              </div>
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .how-to-use-section {
    padding: 3rem 1rem;
    margin: 0 auto;
  }
  
  .how-to-use-header {
    text-align: center;
    margin-bottom: 2rem;
  }
  
  .how-to-use-header h2 {
    font-size: 32px;
    font-weight: 400;
    line-height: 1.2;
    margin: 0;
  }
  
  .how-to-use-steps {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1rem, 3vw, 4rem);
    justify-content: center;
  }
  
  .how-step {
    flex: 1 1 200px;
    min-width: 200px;
    max-width: 260px;
    text-align: left;
  }
  
  .how-step img {
    width: 100%;
    height: auto;
    border-radius: 1rem;
    object-fit: contain;
  }
  
  .how-step h3 {
    margin-top: 1rem;
    margin-bottom: 0.5rem;
    font-size: calc(var(--font-heading-scale) * 1.7rem);
    font-weight: 500;
  }
  
  .how-step p {
    margin: 0;
    line-height: 1.4;
    font-size: 16px;
    font-weight: 400;
  }
  
  /* Tablet and smaller desktop */
  @media (max-width: 990px) {
    .how-step {
      flex: 1 1 180px;
      min-width: 180px;
    }
  }
  
  /* Mobile */
  @media (max-width: 768px) {
    .how-to-use-header h2 {
      font-size: 24px;
    }
    
    .how-to-use-steps {
      flex-direction: column;
      align-items: stretch;
      gap: 1.5rem;
    }
  
    .how-step {
      min-width: 100%;
      max-width: 100%;
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      padding: 0 1rem;
    }
  
    .how-step img {
      width: 45%;
      height: auto;
      flex: 0 0 auto;
      max-width: 260px;
    }
  
    .how-step .text-content {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 0.5rem 0;
    }
  
    .how-step h3 {
      margin-top: 0;
      font-size: calc(var(--font-heading-scale) * 1.4rem);
    }
    
    .how-step p {
      font-size: 14px;
      line-height: 1.5;
    }
  }
  
  @media (max-width: 480px) {
    .how-step {
      padding: 0 0.5rem;
    }
    
    .how-step img {
      width: 40%;
    }
  }
</style>
  
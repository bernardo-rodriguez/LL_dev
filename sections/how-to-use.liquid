{% schema %}
{
  "name": "How To Use",
  "tag": "section",
  "class": "how-to-use-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "How to use"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "Step Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Step Description",
          "default": "Step description goes here"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image Alt Text",
          "default": "Step illustration"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How To Use"
    }
  ]
}
{% endschema %}

<section class="how-to-use-section">
  <div class="page-width">
    <div class="how-to-use-header">
      <h3 class="what-to-expect__title">{{ section.settings.heading }}</h3>
    </div>
    <div class="how-to-use-steps">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'step' %}
            <div class="how-step" {{ block.shopify_attributes }}>
              {% if block.settings.image %}
                <img 
                  src="{{ block.settings.image | image_url: width: 260 }}"
                  alt="{{ block.settings.image_alt | escape }}"
                  width="260"
                  height="260"
                  loading="lazy"
                />
              {% endif %}
              <div class="text-content">
                <h4>{{ block.settings.title }}</h4>
                <p class="whats-in-the-box__text">{{ block.settings.description }}</p>
              </div>
            </div>
        {% endcase %}
      {% endfor %}
    </div>
    <div class="how-to-use-cta">
      <button class="button button--primary" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
        Try it Now
      </button>
    </div>
  </div>
</section>

<style>
  .how-to-use-section {
    padding-top: 40px;
  }
  
  .how-to-use-header {
    text-align: center;
    margin-bottom: 2rem;
  }
  
  .how-to-use-header h1 {
    font-weight: 400;
  }
  
  .how-to-use-steps {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(2rem, 8vw, 10rem);
    justify-content: space-evenly;
    margin-bottom: 3rem;
  }
  
  .how-to-use-cta {
    display: flex;
    justify-content: center;
    margin-bottom: 3rem;
    padding-top: 20px;
  }
  
  .how-to-use-cta .button {
    min-width: 200px;
    font-size: 16px;
    padding: 1rem 2rem;
  }
  
  .how-step {
    flex: 0 0 260px;
    min-width: 200px;
    max-width: 260px;
    text-align: left;
  }
  
  .how-step img {
    width: 100%;
    height: auto;
    border-radius: 1rem;
    object-fit: contain;
  }
  
  
  /* Tablet and smaller desktop */
  @media (max-width: 990px) {
    .how-step {
      flex: 1 1 180px;
      min-width: 180px;
    }
  }
  
  /* Mobile */
  @media (max-width: 768px) {
    
    .how-to-use-steps {
      flex-direction: column;
      align-items: stretch;
      gap: 1.5rem;
    }
  
    .how-step {
      min-width: 100%;
      max-width: 100%;
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0 1rem;
    }
  
    .how-step img {
      width: 45%;
      height: auto;
      flex: 0 0 auto;
      max-width: 260px;
    }
  
    .how-step .text-content {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
  
    {% comment %} .how-step h3 {
      margin: 0;
      font-size: calc(var(--font-heading-scale) * 1.4rem);
      line-height: 1;
    } {% endcomment %}
    
    {% comment %} .how-step p {
      font-size: 14px;
      line-height: 21px;
      margin: 0;
    } {% endcomment %}
  }
  
  @media (max-width: 480px) {
    .how-step {
      padding: 0 0.5rem;
    }
    
    .how-step img {
      width: 40%;
    }
  }
</style>
  
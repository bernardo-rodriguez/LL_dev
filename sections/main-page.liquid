<link rel="stylesheet" href="{{ 'section-main-page.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-rte.css' | asset_url }}" media="print" onload="this.media='all'">

<noscript>{{ 'section-main-page.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-rte.css' | asset_url | stylesheet_tag }}</noscript>

{% if section.settings.heading != blank %}
  {% assign formatted_title = section.settings.heading
    | escape
    | replace: '{', "<span class='stylized'>"
    | replace: '}', '</span>'
  %}
{% else %}
  {% assign formatted_title = page.title | escape | replace: '{', "<span class='stylized'>" | replace: '}', '</span>' %}
{% endif %}

<div class="Default_Page_Header">
  {%- for i in (1..5) -%}
    <h1 class="main-page-title page-title h0">
      {{ formatted_title | newline_to_br }}
    </h1>
  {%- endfor -%}
</div>

<div class="page-width">
  <div class="rte">
    {{ page.content }}
  </div>
</div>
<script>
  // Get the pathname of the current page (e.g., "/collections/all", "/products/my-product")
  const currentPath = window.location.pathname;

  // Get the last part of the pathname (e.g., "all", "my-product")
  const pageHandle = currentPath.split('/').pop();

  if (pageHandle == 'faq') {
    document.getElementsByClassName('default-page-template')[0].style.paddingBottom = '0px';
    document.getElementsByClassName('default-page-template')[0].style.marginBottom = '-40px';
  }
</script>

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "spaced-section default-page-template",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "info": "Wrap italic text in {}"
    }
  ]
}
{% endschema %}

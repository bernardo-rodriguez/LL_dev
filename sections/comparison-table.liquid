{{ 'section-comparison-table.css' | asset_url | stylesheet_tag }}

{% assign formatted_heading = section.settings.heading
  | replace: '{', "<span class='stylized'>"
  | replace: '}', '</span>'
%}

{%- comment -%}
  Laughland is always a yes, so its column is fixed rather than a block.
  Competitor blocks are capped at 4 so the table never exceeds 5 data columns.
{%- endcomment -%}
{% assign competitors = section.blocks | where: 'type', 'competitor' %}
{% assign rows = section.blocks | where: 'type', 'row' %}
{% assign competitor_count = competitors.size %}
{% if competitor_count > 4 %}
  {% assign competitor_count = 4 %}
{% endif %}

<section
  class="comparison-table {% if section.settings.margin_bottom %}comparison-table--with-spacing{% endif %}"
  data-section-id="{{ section.id }}"
  {% if section.settings.flow_visibility == 'quiz' %}data-ll-only="quiz"{% elsif section.settings.flow_visibility == 'direct' %}data-ll-only="direct"{% endif %}
>
  <div class="page-width {% if template == 'product' %}page-width--product{% endif %}">
    <div class="comparison-table__inner">
      {% if section.settings.heading != blank %}
        {%- comment -%}
          The guard is not just an optimisation: it keeps the section from
          reaching for flow-text at all until someone has written an override,
          so a theme that is missing that snippet still renders.
        {%- endcomment -%}
        <h3 class="comparison-table__heading">{% if section.settings.heading_quiz != blank %}{% render 'flow-text', base: section.settings.heading, quiz: section.settings.heading_quiz, stylize: true %}{% else %}{{ formatted_heading }}{% endif %}</h3>
      {% endif %}

      {% if rows.size > 0 %}
        {%- comment -%} Label column + Laughland + one column per competitor {%- endcomment -%}
        <div
          class="comparison-table__grid"
          style="--comparison-columns: {{ competitor_count | plus: 1 }};"
          role="table"
        >
          <div class="comparison-table__row-head" role="row">
            <div class="comparison-table__cell comparison-table__cell--corner" role="columnheader"></div>

            <div class="comparison-table__cell comparison-table__cell--ours comparison-table__cell--head" role="columnheader">
              {%- comment -%}
                Custom SVG wins, then a picked image, then the wordmark snippet.
                The snippet's fills are currentColor, so CSS tints it to cream
                against the navy column.
              {%- endcomment -%}
              {% if section.settings.ours_logo_svg != blank %}
                <span class="comparison-table__logo">{{ section.settings.ours_logo_svg }}</span>
              {% elsif section.settings.ours_logo != blank %}
                <span class="comparison-table__logo">
                  <img
                    src="{{ section.settings.ours_logo | image_url: width: 320 }}"
                    alt="{{ section.settings.ours_label | escape }}"
                    loading="lazy"
                  >
                </span>
              {% else %}
                <span class="comparison-table__logo">{% render 'laughland-wordmark' %}</span>
              {% endif %}
              <span class="visually-hidden">{{ section.settings.ours_label }}</span>
            </div>

            {% for block in competitors limit: competitor_count %}
              <div class="comparison-table__cell comparison-table__cell--head" role="columnheader" {{ block.shopify_attributes }}>
                <span class="comparison-table__col-label">{{ block.settings.heading }}</span>
              </div>
            {% endfor %}
          </div>

          {% for row in rows %}
            <div class="comparison-table__row" role="row" {{ row.shopify_attributes }}>
              <div class="comparison-table__cell comparison-table__cell--label" role="rowheader">
                <span class="comparison-table__label body-md">{{ row.settings.label }}</span>
              </div>

              {%- comment -%}
                A text row (price, say) prints a value in every column instead
                of a tick or a cross. Laughland is still fixed, but its value
                comes from the row rather than being an automatic yes.
              {%- endcomment -%}
              {% assign is_text_row = false %}
              {% if row.settings.row_type == 'text' %}
                {% assign is_text_row = true %}
              {% endif %}

              <div class="comparison-table__cell comparison-table__cell--ours" role="cell">
                {% if is_text_row %}
                  <span class="comparison-table__value comparison-table__value--ours">{{ row.settings.ours_text }}</span>
                {% else %}
                  <span class="comparison-table__mark comparison-table__mark--yes">
                    {% render 'icon', icon: 'checkmark' %}
                    <span class="visually-hidden">Yes</span>
                  </span>
                {% endif %}
              </div>

              {% for block in competitors limit: competitor_count %}
                {%- comment -%}
                  Blocks cannot have a variable number of settings, so each row
                  carries four toggles and four text values, and we read the
                  first N of whichever set this row type uses.
                {%- endcomment -%}
                <div class="comparison-table__cell" role="cell">
                  {% if is_text_row %}
                    {% assign text_key = 'col_' | append: forloop.index | append: '_text' %}
                    <span class="comparison-table__value">{{ row.settings[text_key] }}</span>
                  {% else %}
                    {% assign key = 'col_' | append: forloop.index %}
                    {% if row.settings[key] %}
                      <span class="comparison-table__mark comparison-table__mark--yes">
                        {% render 'icon', icon: 'checkmark' %}
                        <span class="visually-hidden">Yes</span>
                      </span>
                    {% else %}
                      <span class="comparison-table__mark comparison-table__mark--no">
                        <svg class="comparison-table__cross" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                          <path d="M6 6 L18 18 M18 6 L6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                        </svg>
                        <span class="visually-hidden">No</span>
                      </span>
                    {% endif %}
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% if section.settings.footnote != blank %}
        <p class="comparison-table__footnote stylized">{{ section.settings.footnote }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparison Table",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Laughland is a {whole-mouth} solution",
      "info": "Wrap emphasized text in {} for the italic Canela style"
    },
    {
      "type": "text",
      "id": "ours_label",
      "label": "Laughland column name",
      "default": "Laughland",
      "info": "Used as the accessible name for the logo, and as the fallback if no logo is supplied."
    },
    {
      "type": "textarea",
      "id": "ours_logo_svg",
      "label": "Laughland logo (inline SVG)",
      "info": "Optional. Overrides the built-in wordmark. Use fill=\"currentColor\" so it picks up the column colour."
    },
    {
      "type": "image_picker",
      "id": "ours_logo",
      "label": "Laughland logo (image)",
      "info": "Optional. Used when no inline SVG is set. An image cannot be recoloured, so supply a light version."
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Footnote",
      "default": "†Based on currently available data for mass-market at-home whitening products."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "margin_bottom",
      "label": "Extra space below",
      "default": false,
      "info": "Off by default. Sections carry their spacing on top, so the next one supplies the gap. Turn on only when this section ends the page."
    },
    {
      "type": "header",
      "content": "Personalization flow"
    },
    {
      "type": "select",
      "id": "flow_visibility",
      "label": "Show this section to",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "Everyone"
        },
        {
          "value": "quiz",
          "label": "Quiz arrivals only"
        },
        {
          "value": "direct",
          "label": "Direct arrivals only"
        }
      ],
      "info": "Quiz arrivals completed the customization quiz on the landing page. Preview either flow by adding ?ll_flow=quiz or ?ll_flow=direct to the page URL."
    },
    {
      "type": "textarea",
      "id": "heading_quiz",
      "label": "Heading — quiz arrivals",
      "info": "Optional. Wording for visitors who came through the quiz. One per line: a line on its own applies to all of them, a line starting strong:, medium: or sensitive: applies to that formula only. Anything left out falls back to the wording above."
    }
  ],
  "blocks": [
    {
      "type": "competitor",
      "name": "Competitor column",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column heading",
          "default": "Whitening Strips"
        }
      ]
    },
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Row label",
          "default": "Lifts deep-set stains"
        },
        {
          "type": "select",
          "id": "row_type",
          "label": "Row type",
          "default": "marks",
          "options": [
            {
              "value": "marks",
              "label": "Yes / no marks"
            },
            {
              "value": "text",
              "label": "Text values (e.g. price)"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": "Yes / no rows: Laughland is always a yes, and the checkboxes below map to the competitor columns in order. Text rows use the value fields instead. Extra entries are ignored."
        },
        {
          "type": "header",
          "content": "Yes / no rows"
        },
        {
          "type": "checkbox",
          "id": "col_1",
          "label": "Competitor 1",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "col_2",
          "label": "Competitor 2",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "col_3",
          "label": "Competitor 3",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "col_4",
          "label": "Competitor 4",
          "default": false
        },
        {
          "type": "header",
          "content": "Text rows"
        },
        {
          "type": "text",
          "id": "ours_text",
          "label": "Laughland value",
          "default": "$39"
        },
        {
          "type": "text",
          "id": "col_1_text",
          "label": "Competitor 1 value"
        },
        {
          "type": "text",
          "id": "col_2_text",
          "label": "Competitor 2 value"
        },
        {
          "type": "text",
          "id": "col_3_text",
          "label": "Competitor 3 value"
        },
        {
          "type": "text",
          "id": "col_4_text",
          "label": "Competitor 4 value"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison Table",
      "blocks": [
        {
          "type": "competitor",
          "settings": {
            "heading": "Whitening Strips"
          }
        },
        {
          "type": "competitor",
          "settings": {
            "heading": "Whitening Toothpaste"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Lifts deep-set stains",
            "col_1": true,
            "col_2": false
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Dentist-grade strength",
            "col_1": false,
            "col_2": false
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Strengthens enamel",
            "col_1": false,
            "col_2": false
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Sensitivity protection",
            "col_1": false,
            "col_2": false
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Removes plaque & biofilm",
            "col_1": false,
            "col_2": true
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Supports oral microbiome",
            "col_1": false,
            "col_2": false
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Prescribed to your smile",
            "col_1": false,
            "col_2": false
          }
        }
      ]
    }
  ]
}
{% endschema %}

{{ 'section-hero-two-column.css' | asset_url | stylesheet_tag }}

{%- comment -%} Judge.me: when a product is set, use that product's review count (hidden widget) so it matches product page; otherwise use shop-wide count {%- endcomment -%}
<div class="hero-two-column__judgeme-source visually-hidden" aria-hidden="true">
  {% if section.settings.review_product != blank %}
    {% render 'judgeme_widgets', widget_type: 'judgeme_review_widget', concierge_install: true, product: section.settings.review_product, auto_install: false %}
  {% else %}
    {% render 'judgeme_widgets', widget_type: 'judgeme_all_reviews_text', concierge_install: true %}
  {% endif %}
</div>

{% assign formatted_headline = section.settings.headline
  | replace: '{', "<span class='stylized'>"
  | replace: '}', '</span>'
%}

<section class="hero-two-column">
  <div class="page-width hero-two-column__inner">
    <div class="hero-two-column__flex">
      {%- comment -%} Left column: content {%- endcomment -%}
      <div class="hero-two-column__content">
        {% if section.settings.headline != blank %}
          <h3 class="hero-two-column__headline h3">{{ formatted_headline | newline_to_br }}</h3>
        {% endif %}

        {% if section.settings.description != blank %}
          <p class="hero-two-column__description sh2">{{ section.settings.description }}</p>
        {% endif %}

        {% if section.settings.button_label != blank %}
          {% if section.settings.button_link != blank %}
            <a href="{{ section.settings.button_link }}" class="hero-two-column__cta button button--secondary" {% if section.settings.button_action == "quiz" %}data-open-quiz{% endif %} {% if settings.discount_code != blank %}onclick="window.localStorage.setItem('landing_page_product_discount','{{ settings.discount_code }}')"{% endif %}>
              {{ section.settings.button_label }}
            </a>
          {% else %}
            <button type="button" class="hero-two-column__cta button button--secondary" {% if section.settings.button_action == "quiz" %}data-open-quiz{% endif %} {% if settings.discount_code != blank %}onclick="window.localStorage.setItem('landing_page_product_discount','{{ settings.discount_code }}')"{% endif %}>
              {{ section.settings.button_label }}
            </button>
          {% endif %}
        {% endif %}

        {% if section.settings.review_count != blank or section.settings.rating != blank or section.settings.testimonial_text != blank %}
          <div class="hero-two-column__review-block hero-two-column__review-block--desktop">
            {% if section.settings.rating != blank or section.settings.review_count != blank %}
              <div class="hero-two-column__small-stars body-sm">
                <span class="hero-two-column__stars">{% render 'icon' icon: 'review-5-star' %}</span>
                {% if section.settings.rating != blank %}
                  <span class="hero-two-column__small-stars-rating">{{ section.settings.rating }}</span>
                {% endif %}
                <span class="small-stars-review-count">{% if section.settings.review_count != blank %}{{ section.settings.review_count }}{% endif %}</span>
              </div>
            {% endif %}
            {% if section.settings.review_author != blank %}
              <div class="hero-two-column__review-author-line sh2">— {{ section.settings.review_author }}</div>
            {% endif %}
            {% if section.settings.testimonial_text != blank %}
              <blockquote class="hero-two-column__testimonial body-sm">{{ section.settings.testimonial_text }}</blockquote>
            {% endif %}
          </div>
        {% endif %}
      </div>

      {%- comment -%} Right column: product image; on mobile this becomes a card with image + review {%- endcomment -%}
      <div class="hero-two-column__image-col">
        <div class="hero-two-column__image-card">
          {% if section.settings.product_image_url != blank %}
            <div class="hero-two-column__image-box">
              <img src="{{ section.settings.product_image_url }}" alt="" loading="lazy" width="280" height="280">
            </div>
          {% elsif section.settings.product_image != blank %}
            <div class="hero-two-column__image-box">
              {% if section.settings.mobile_image != blank %}
                {% render 'lazy-image', image: section.settings.product_image, fade: true, fill: true, classes: 'hero-two-column__img hide-mobile' %}
                {% render 'lazy-image', image: section.settings.mobile_image, fade: true, fill: true, classes: 'hero-two-column__img hide-desktop' %}
              {% else %}
                {% render 'lazy-image', image: section.settings.product_image, fade: true, fill: true, classes: 'hero-two-column__img' %}
              {% endif %}
            </div>
          {% endif %}
          {%- comment -%} Mobile-only: review as lower container on the image card {%- endcomment -%}
          {% if section.settings.rating != blank or section.settings.review_count != blank or section.settings.testimonial_text != blank %}
            <div class="hero-two-column__review-block hero-two-column__review-block--mobile">
              {% if section.settings.rating != blank or section.settings.review_count != blank %}
                <div class="hero-two-column__small-stars body-sm">
                  <span class="hero-two-column__stars">{% render 'icon' icon: 'review-5-star' %}</span>
                  {% if section.settings.rating != blank %}
                    <span class="hero-two-column__small-stars-rating">{{ section.settings.rating }}</span>
                  {% endif %}
                  <span class="small-stars-review-count">{% if section.settings.review_count != blank %}{{ section.settings.review_count }}{% endif %}</span>
                </div>
              {% endif %}
              {% if section.settings.review_author != blank %}
                <div class="hero-two-column__review-author-line sh2">— {{ section.settings.review_author }}</div>
              {% endif %}
              {% if section.settings.testimonial_text != blank %}
                <blockquote class="hero-two-column__testimonial body-sm">{{ section.settings.testimonial_text }}</blockquote>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    function getReviewCountFromElement(el) {
      if (!el || !el.textContent) return null;
      var match = el.textContent.match(/based on (\d[\d,]*)\s*reviews?/i);
      return match ? parseInt(match[1].replace(/,/g, ''), 10) : null;
    }
    function updateSmallStarsReviewCount() {
      var summaryText = document.querySelector('.jdgm-rev-widg__summary-text');
      var allReviewsText = document.querySelector('.jdgm-all-reviews-text__text');
      var rawCount = null;
      if (summaryText) rawCount = getReviewCountFromElement(summaryText);
      if (rawCount == null && allReviewsText) rawCount = getReviewCountFromElement(allReviewsText);
      if (rawCount != null) {
        var displayCount = rawCount < 1000 ? rawCount + 2000 : rawCount;
        var text = displayCount.toLocaleString() + ' Reviews';
        document.querySelectorAll('.small-stars-review-count').forEach(function(el) { el.textContent = text; });
        return true;
      }
      return false;
    }
    if (!updateSmallStarsReviewCount()) {
      var obs = new MutationObserver(function(mutations, observer) {
        if (updateSmallStarsReviewCount()) observer.disconnect();
      });
      obs.observe(document.body, { childList: true, subtree: true, characterData: true });
      setTimeout(updateSmallStarsReviewCount, 2000);
      setTimeout(updateSmallStarsReviewCount, 5000);
      setTimeout(updateSmallStarsReviewCount, 10000);
    }
  })();
</script>

{% schema %}
{
  "name": "Hero Two Column",
  "tag": "section",
  "class": "section-hero-two-column",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Headline",
      "info": "Wrap italic/stylized text in {}"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "select",
      "id": "button_action",
      "label": "Button Action",
      "options": [
        {
          "value": "url",
          "label": "Redirect to URL"
        },
        {
          "value": "quiz",
          "label": "Open Quiz"
        }
      ],
      "default": "quiz"
    },
    {
      "type": "header",
      "content": "Customer Review Block"
    },
    {
      "type": "product",
      "id": "review_product",
      "label": "Product for review count",
      "info": "Select the product whose review count to show (e.g. your main kit). Leave blank to use shop-wide count."
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Rating",
      "info": "e.g. 4.7/5 (same as product page small-stars)"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review Count",
      "info": "e.g. 80,000+ Reviews"
    },
    {
      "type": "text",
      "id": "review_author",
      "label": "Review Author",
      "info": "e.g. KEITH N."
    },
    {
      "type": "textarea",
      "id": "testimonial_text",
      "label": "Testimonial Text"
    },
    {
      "type": "header",
      "content": "Product Image"
    },
    {
      "type": "text",
      "id": "product_image_url",
      "label": "Product Image URL",
      "info": "Optional. CDN or direct image URL. When set, overrides the image picker below."
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image",
      "info": "Used when Product Image URL is blank."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image",
      "info": "Optional. Uses product image if blank."
    }
  ],
  "presets": [
    {
      "name": "Hero Two Column"
    }
  ]
}
{% endschema %}

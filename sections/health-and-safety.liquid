{{ 'section-health-and-safety.css' | asset_url | stylesheet_tag }}

<section class="health-and-safety" data-section-id="{{ section.id }}">
  <div class="page-width {% if template == 'product' %}page-width--product{% endif %}">
    {% if section.settings.heading != blank %}
      <div class="health-and-safety__header">
        <h3 class="health-and-safety__heading">{{ section.settings.heading }}</h3>
      </div>
    {% endif %}

    <div class="health-and-safety__columns">
      <div class="health-and-safety__left">
        {% if section.blocks.size > 0 %}
          <div class="health-and-safety__rows">
            {% for block in section.blocks %}
              {% if block.type == 'row' %}
                <div class="health-and-safety__row" {{ block.shopify_attributes }}>
                  <div class="health-and-safety__row-icon" aria-hidden="true">
                    {% if block.settings.icon != blank %}
                      <img
                        src="{{ block.settings.icon | image_url: width: 80 }}"
                        alt=""
                        width="40"
                        height="40"
                        loading="lazy"
                      >
                    {% endif %}
                  </div>
                  <div class="health-and-safety__row-content">
                    {% if block.settings.heading != blank %}
                      <p class="health-and-safety__row-heading sh2">{{ block.settings.heading }}</p>
                    {% endif %}
                    {% if block.settings.text != blank %}
                      <p class="health-and-safety__row-text body-sm">{{ block.settings.text }}</p>
                    {% endif %}
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="health-and-safety__right">
        <div class="health-and-safety__panels">
          <div class="health-and-safety__panel">
            {% if section.settings.panel_1_image != blank %}
              <div class="health-and-safety__panel-image-wrap">
                <img
                  src="{{ section.settings.panel_1_image | image_url: width: 600 }}"
                  srcset="
                    {{ section.settings.panel_1_image | image_url: width: 300 }} 300w,
                    {{ section.settings.panel_1_image | image_url: width: 450 }} 450w,
                    {{ section.settings.panel_1_image | image_url: width: 600 }} 600w"
                  sizes="(min-width: 769px) 25vw, 50vw"
                  alt="{{ section.settings.panel_1_heading | escape }}"
                  class="health-and-safety__panel-image"
                  loading="lazy"
                  width="{{ section.settings.panel_1_image.width }}"
                  height="{{ section.settings.panel_1_image.height }}"
                >
              </div>
            {% endif %}
            {% if section.settings.panel_1_heading != blank %}
              <p class="health-and-safety__panel-heading sh2">{{ section.settings.panel_1_heading }}</p>
            {% endif %}
            {% if section.settings.panel_1_text != blank %}
              <p class="health-and-safety__panel-text body-sm">{{ section.settings.panel_1_text }}</p>
            {% endif %}
          </div>

          <div class="health-and-safety__panel-divider" aria-hidden="true"></div>

          <div class="health-and-safety__panel">
            {% if section.settings.panel_2_image != blank %}
              <div class="health-and-safety__panel-image-wrap">
                <img
                  src="{{ section.settings.panel_2_image | image_url: width: 600 }}"
                  srcset="
                    {{ section.settings.panel_2_image | image_url: width: 300 }} 300w,
                    {{ section.settings.panel_2_image | image_url: width: 450 }} 450w,
                    {{ section.settings.panel_2_image | image_url: width: 600 }} 600w"
                  sizes="(min-width: 769px) 25vw, 50vw"
                  alt="{{ section.settings.panel_2_heading | escape }}"
                  class="health-and-safety__panel-image"
                  loading="lazy"
                  width="{{ section.settings.panel_2_image.width }}"
                  height="{{ section.settings.panel_2_image.height }}"
                >
              </div>
            {% endif %}
            {% if section.settings.panel_2_heading != blank %}
              <p class="health-and-safety__panel-heading sh2">{{ section.settings.panel_2_heading }}</p>
            {% endif %}
            {% if section.settings.panel_2_text != blank %}
              <p class="health-and-safety__panel-text body-sm">{{ section.settings.panel_2_text }}</p>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Health and Safety",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Health & Safety"
    },
    {
      "type": "header",
      "content": "Right column — left panel"
    },
    {
      "type": "image_picker",
      "id": "panel_1_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "panel_1_heading",
      "label": "Title",
      "default": "Aloe Vera"
    },
    {
      "type": "textarea",
      "id": "panel_1_text",
      "label": "Description",
      "default": "Known for its soothing properties, aloe vera helps calm and hydrate gums while supporting comfort."
    },
    {
      "type": "header",
      "content": "Right column — right panel"
    },
    {
      "type": "image_picker",
      "id": "panel_2_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "panel_2_heading",
      "label": "Title",
      "default": "Hydroxyapatite"
    },
    {
      "type": "textarea",
      "id": "panel_2_text",
      "label": "Description",
      "default": "A naturally occurring mineral that helps support enamel and reduce sensitivity."
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Row heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Row description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Health and Safety",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "heading": "Safe Manufacturing",
            "text": "Our products are manufactured in an FDA-registered facility and follow strict safety protocols."
          }
        },
        {
          "type": "row",
          "settings": {
            "heading": "Pharmaceutical Grade",
            "text": "We use pharmaceutical-grade ingredients for the highest level of quality and effectiveness."
          }
        },
        {
          "type": "row",
          "settings": {
            "heading": "Gentle & Non-Irritating",
            "text": "Formulated to be gentle on enamel and gums while delivering noticeable results."
          }
        }
      ]
    }
  ]
}
{% endschema %}

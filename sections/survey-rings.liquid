{%- comment -%}
  The v2 artboard draws the customer-survey figures as three ring gauges,
  centred under a centred heading: a hairline track, a blue arc for the
  figure itself, the number inside the ring and the claim below it.

  It is its own section rather than a variant of transformational-results,
  which draws the same numbers as left-ranged pill rows and is still used
  further down this page for "Over 100,000 brighter smiles".
{%- endcomment -%}

{{ 'section-survey-rings.css' | asset_url | stylesheet_tag }}

<div class="survey-rings">
  <div class="survey-rings__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="survey-rings__head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="survey-rings__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="survey-rings__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="survey-rings__grid" style="--survey-cols: {{ section.blocks.size }};">
        {%- for block in section.blocks -%}
          {%- comment -%}
            The arc length is the figure's own percentage of the ring. A
            rating is written "4.7" out of its own scale, so it is converted
            here rather than asking the editor for a second number.
          {%- endcomment -%}
          {%- assign raw = block.settings.value | strip -%}
          {%- assign num = raw | replace: '%', '' | replace: '★', '' | replace: '☆', '' | strip | times: 1.0 -%}
          {%- assign scale = block.settings.scale | times: 1.0 -%}
          {%- if scale <= 0 -%}{%- assign scale = 100.0 -%}{%- endif -%}
          {%- assign frac = num | divided_by: scale -%}
          {%- if frac > 1 -%}{%- assign frac = 1 -%}{%- endif -%}
          {%- if frac < 0 -%}{%- assign frac = 0 -%}{%- endif -%}
          {%- assign circumference = 213.628 -%}
          {%- assign arc = circumference | times: frac -%}

          <div class="survey-rings__cell" {{ block.shopify_attributes }}>
            <span class="survey-rings__ring">
              <svg viewBox="0 0 84 84" width="84" height="84" aria-hidden="true" focusable="false">
                <circle class="survey-rings__track" cx="42" cy="42" r="34"></circle>
                <circle
                  class="survey-rings__arc"
                  cx="42"
                  cy="42"
                  r="34"
                  stroke-dasharray="{{ arc }} {{ circumference }}"
                ></circle>
              </svg>
              <span class="survey-rings__value">{{ block.settings.value }}</span>
            </span>
            {%- comment -%}
              review-totals.js reads the line's template out of the
              data-ll-reviews attribute and writes the finished line back as
              the element's text, so the whole claim carries the attribute
              rather than a token span inside it.
            {%- endcomment -%}
            {%- comment -%}
              The token is built rather than written out: Shopify's Liquid
              lexer will not accept a brace inside an output tag's string.
            {%- endcomment -%}
            {%- assign reviews_token = '{' | append: 'reviews' | append: '}' -%}
            {%- if block.settings.text contains reviews_token -%}
              {%- assign placeholder = block.settings.text | replace: reviews_token, '' | replace: '  ', ' ' -%}
              <span class="survey-rings__text" data-ll-reviews="{{ block.settings.text | escape }}">{{ placeholder }}</span>
            {%- else -%}
              <span class="survey-rings__text">{{ block.settings.text }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.footnote != blank -%}
      <p class="survey-rings__footnote">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Survey rings",
  "tag": "section",
  "class": "section-survey-rings",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Customer survey"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Results you can see, and feel good about."
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",
      "default": "Laughland customer survey, n = 918. Individual results vary."
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Figure",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Figure",
          "default": "97%",
          "info": "Shown inside the ring. A % or a star rating both work."
        },
        {
          "type": "text",
          "id": "scale",
          "label": "Out of",
          "default": "100",
          "info": "How much fills the ring completely. Use 100 for a percentage, 5 for a rating."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Claim",
          "default": "saw whiter teeth after 6 uses",
          "info": "Use {reviews} to drop in the live review total."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Survey rings",
      "blocks": [{ "type": "stat" }, { "type": "stat" }, { "type": "stat" }]
    }
  ]
}
{% endschema %}

{{ 'section-whats-in-the-box.css' | asset_url | stylesheet_tag }}

<div class="whats-in-the-box section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="whats-in-the-box__container">
      <div class="whats-in-the-box__content">
        {% if section.settings.title != blank %}
          <h2 class="whats-in-the-box__title h1">{{ section.settings.title }}</h2>
        {% endif %}
      </div>

      <div class="whats-in-the-box__mobile-wrapper">
        <div class="whats-in-the-box__image">
          {% if section.settings.image != blank %}
            {%- assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio -%}
            {{ section.settings.image | image_url: width: section.settings.image.width | image_tag:
              loading: 'lazy',
              width: section.settings.image.width,
              height: image_height,
              alt: section.settings.image.alt | escape
            }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
        
        <div class="whats-in-the-box__items">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'text_item' %}
                <div class="whats-in-the-box__item" {{ block.shopify_attributes }}>
                  {% if block.settings.subheading != blank %}
                    <h3 class="whats-in-the-box__subheading">{{ block.settings.subheading }}</h3>
                  {% endif %}
                  <div class="whats-in-the-box__text">{{ block.settings.text }}</div>
                </div>
            {% endcase %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "What's in the Box",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "What's in the Box"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "padding_top",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium",
      "label": "Top padding"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium",
      "label": "Bottom padding"
    }
  ],
  "blocks": [
    {
      "type": "text_item",
      "name": "Text Item",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Feature Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Add your text here</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "What's in the Box",
      "blocks": [
        {
          "type": "text_item",
          "settings": {
            "subheading": "Premium Quality",
            "text": "<p>Premium whitening strips for a brighter smile</p>"
          }
        },
        {
          "type": "text_item",
          "settings": {
            "subheading": "Gentle Formula",
            "text": "<p>Professional-grade formula that's gentle on sensitive teeth</p>"
          }
        },
        {
          "type": "text_item",
          "settings": {
            "subheading": "Quick Results",
            "text": "<p>14-day treatment for lasting results</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% stylesheet %}
.whats-in-the-box {
  padding: var(--section-padding);
}

.whats-in-the-box__container {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.whats-in-the-box__content {
  text-align: center;
}

.whats-in-the-box__mobile-wrapper {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.whats-in-the-box__title {
  margin-bottom: 2rem;
}

@media screen and (min-width: 750px) {
  .whats-in-the-box__container {
    padding: 40px;
  }

  .whats-in-the-box__mobile-wrapper {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 4rem;
  }

  .whats-in-the-box__content {
    text-align: left;
  }

  .whats-in-the-box__content,
  .whats-in-the-box__image {
    flex: 1;
  }
}

.whats-in-the-box__items {
  display: flex;
  flex-direction: column;
  gap: 2rem;
  width: 100%;
  max-width: 500px;
  margin: 0 auto;
}

.whats-in-the-box__item {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.whats-in-the-box__subheading {
  margin: 0;
  font-size: calc(var(--font-heading-scale) * 1.7rem);
  font-weight: 600;
}

.whats-in-the-box__text {
  flex: 1;
}

.whats-in-the-box__text p {
  margin: 0;
}

.whats-in-the-box__image {
  display: flex;
  justify-content: center;
  align-items: center;
}

.whats-in-the-box__image img {
  width: auto;
  max-width: 100%;
  height: auto;
  max-height: 500px;
  display: block;
  border-radius: 16px;
  object-fit: contain;
}
{% endstylesheet %} 
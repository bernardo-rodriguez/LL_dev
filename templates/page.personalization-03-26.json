    "a4c5d03d-76b9-4c42-a509-36657ba4b556": {
      "type": "section-reviews",
      "blocks": {
        "89a41fcd-2300-427b-82fa-c9fb649485da": {
          "type": "review",
          "settings": {
            "title": "I Had to say something",
            "text": "\"I had to come here to say something. Normally I have excruciating pain with crest white strips and this other brand I got from the dentist. Both of which didn’t whiten my teeth very much. So, I had low hopes for laughland. I got the formula made for highest sensitivity, and I left it on for I think 12 minutes. Just after the first day my teeth look 2 shades whiter. I’m actually really shocked.\"",
            "author": "Loren S."
          }
        },
        "14cebb8f-f4fa-4a74-8811-da9796c988c8": {
          "type": "review",
          "settings": {
            "title": "I didn't like smiling",
            "text": "\"My teeth had gotten so yellow that I didn't like smiling - especially when I wore lipstick, it made the teeth look more icky. 6 treatments later, it's gotten SO much whiter and I'm wearing lipstick again :)\"",
            "author": "Jenna B."
          }
        },
        "0d0c4cab-c7c5-4776-8a8f-ff7cad80d03f": {
          "type": "review",
          "settings": {
            "title": "I'm Obsessed!",
            "text": "\"I thought hey worth a shot not really expecting anything great. Wow was I wrong! This has absolutely worked wonders on my teeth! Refill kit has been ordered! I’m obsessed!\"",
            "author": "Mindy R."
          }
        },
        "f2f45f4e-db0e-473f-9a80-38aabf0a1791": {
          "type": "review",
          "settings": {
            "title": "I. Hate. Whitening. Kits",
            "text": "\"I. Hate. Whitening. Kits. Except this one. It's easy to use, doesn't create a huge mess, is comfortable (even for small-mouthed folks like me!), and doesn't make your teeth feel slimy and taste weird. Plus, it's SO EFFECTIVE. Worth every penny.\"",
            "author": "Anna C."
          }
        },
        "c727961b-a7cf-4471-87fb-fa8302009ec1": {
          "type": "review",
          "settings": {
            "title": "My teeth are sparkling",
            "text": "\"This is my best purchase ever. This item OVER-Delivers. My teeth are sparkling and I had ZERO pain. Great Job Laughland.\"",
            "author": "Addison J."
          }
        },
        "2c52ec03-04aa-4e36-bb46-206b519f147f": {
          "type": "review",
          "settings": {
            "title": "LOVE THIS!",
            "text": "\"LOVE THIS! My coworkers have been throwing compliments left and right about how my teeth have been shining. THANK YOU!\"",
            "author": "Audrey C."
          }
        }
      },

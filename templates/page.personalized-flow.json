      "blocks": {
        "faq_jcePmi": {
          "type": "faq",
          "settings": {
            "title": "Can I use the mouthpiece on top and bottom teeth?",
            "sub_title": "<p><em>The LED mouthpiece is designed to be used for both the top and bottom teeth simultaneously, ensuring an effective whitening process.<br/><br/>To help you with the process, please watch this video. It provides step-by-step guidance on how to use the tray effectively.</em></p>"
          }
        },
        "faq_Fc7gWN": {
          "type": "faq",
          "settings": {
            "title": "Can I cancel or return a subscription refill order after it has been processed or shipped?",
            "sub_title": "<p><em>Unfortunately, once an order has been processed or shipped, we are unable to make changes, cancel it, or issue a refund. However, you are welcome to cancel your subscription at any point before the order is processed - please login to your account to cancel it or reach out to us at team@mylaughland.com at least three days before your next order.</em></p>"
          }
        },
        "faq_FThF9j": {
          "type": "faq",
          "settings": {
            "title": "Can I cancel my subscription whenever?",
            "sub_title": "<p><em>You can cancel your susbcription whenever! All we ask is you try the whitening treatment for the full 6-day cycle before cancelling. To cancel, please log into your account or contact us on team@mylaughland.com at least 3 days before your next shipment to avoid further charges.</em></p>"
          }
        },
        "faq_kY37yt": {
          "type": "faq",
          "settings": {
            "title": "What should I do if my order hasn't been delivered or was sent to the wrong address?",
            "sub_title": "<p><em>If your package hasn’t arrived within the delivery time, please check your mailbox, front porch, and surrounding area, If still not found please contact the courier to see where the order has been delivered. Keep us updated on their response, and we’ll assist you further.</em></p>"
          }
        },
        "faq_TFKdWm": {
          "type": "faq",
          "settings": {
            "title": "What are the ingredients in Laughland’s whitening formula?",
            "sub_title": "<p><em>Our whitening formula has been rigorously tested in clinical trials for efficacy and includes: <br/><br/>One of two active ingredients - Hydrogen Peroxide and Sodium Bicarbonate. Our Extra Strength Formula has 38% more active whitening ingredient than the Standard Formula. <br/><br/>Other ingredients include Glycerin, Cellulose Gum, Sodium Hydroxide, Aloe Vera, and Mint Extract. To learn more about these ingredients and their reactions, visit our Science page.</em></p>"
          }
        },
        "faq_44QXDj": {
          "type": "faq",
          "settings": {
            "title": "Can I use the whitening formula on repaired, capped, veneered, bridged, or dentured teeth?",
            "sub_title": "<p><em>Our whitening formula works effectively on natural enamel but typically does not alter the color of restorative materials like bonding, composite resins, caps, veneers, bridges, or dentures. The product is safe to use around caps and veneers, helping whiten surrounding natural teeth for a balanced look.</em></p>"
          }
        },
        "faq_4je8aW": {
          "type": "faq",
          "settings": {
            "title": "What is the To-go pen?",
            "sub_title": "<p><em>Our Whitening Pen is an instant whitener designed for on-the-go use. The size of a long lipstick, it fits neatly into purses and pockets, allowing you to quickly and conveniently brighten your smile whenever and wherever you need it. It uses the exact same whitening formula as the standard whitening kit. </em></p>"
          }
        },
        "faq_wna9ac": {
          "type": "faq",
          "settings": {
            "title": "How do I login to my account?",
            "sub_title": "<p><em>The subscription plan now allows you to log in without a password. Simply click on \"My Account\", forgot password, enter your email, and you'll receive a login code to access your account.</em></p>"
          }
        },
        "faq_BxiYDM": {
          "type": "faq",
          "settings": {
            "title": "Will the treatment work in tetracycline stained teeth?",
            "sub_title": "<p><em>Our Standard (8-16) and Extra Strength (8-17) formulas consist of Hydrogen Peroxide will work on the stained teeth, including tetracycline stained teeth.</em></p>"
          }
        },
        "faq_Wt4ef7": {
          "type": "faq",
          "settings": {
            "title": "Does Laughland test on Animals?",
            "sub_title": "<p><em>No, Laughland does not test on any animals and is manufactured following cruelty-free standards. Also, all our ingredients are vegan!</em></p>"
          }
        }
      },
